        ArrowBox[
         BezierCurveBox[{{
          0.8660254037844389, -0.5000000000000012}, {-2.930024046187862*^-15, \
-0.7848197289557464}, {-0.8660254037844384, -0.49999999999999933`}}], 
         0.020399597244776385`], 
        ArrowBox[
         BezierCurveBox[{{0.8660254037844389, -0.5000000000000012}, {
          0.18635158111754768`, 0.10759013552212278`}, {
          1.8369701987210297`*^-16, 1.}}], 0.020399597244776385`]}, 
       {Hue[0.6, 0.5, 1.], EdgeForm[{GrayLevel[0], Opacity[
        0.7]}], {
