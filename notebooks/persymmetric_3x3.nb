{-0.6796738226668951, 0.3924098644778713}, {1.8369701987210297`*^-16, 1.}}], 
         0.020399597244776385`], 
        ArrowBox[
         BezierCurveBox[{{-0.8660254037844384, -0.49999999999999933`}, {
          9.175601618325135*^-15, -0.21518027104425425`}, {
