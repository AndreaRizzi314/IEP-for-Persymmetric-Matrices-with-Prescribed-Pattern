Notebook[{

Cell[CellGroupData[{
Cell["Persymmetric 3 \[Times] 3 matrices", "Title",ExpressionUUID->"1a23e6f7-cfb2-be45-8bd2-9f70cbece0a4"],

Cell["\<\
Characteristic polynomials, nilpotency, and prescribed patterns\
\>", "Subtitle",ExpressionUUID->"67f7b603-c1ee-b444-a49f-b42b1c8498ad"],

Cell["\<\
All parameters are real unless stated otherwise. The input cells are \
evaluated sequentially, using exact arithmetic throughout.\
\>", "Text",ExpressionUUID->"2a963af7-5aba-624b-84e1-689f9d64a09e"],

Cell[CellGroupData[{

Cell["1. The general persymmetric matrix", "Section",ExpressionUUID->"917e3af2-1be2-184c-be48-f7155335f40e"],

Cell["\<\
Let J denote the reversal matrix of order 3. Since J = J\:1d40 = J\:207b\.b9, \
the persymmetry condition A = JA\:1d40J is equivalent to the symmetry of JA. \
The general form below has six independent real parameters; the anti-diagonal \
entries d, e and f are unconstrained by the reflection.\
\>", "Text",ExpressionUUID->"e6ba781a-89fb-344d-b17f-c89bd3e4254f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";", " ", 
  RowBox[{"j3", " ", "=", " ", 
   RowBox[{"Reverse", "[", 
    RowBox[{"IdentityMatrix", "[", "3", "]"}], "]"}]}], ";", " ", 
  RowBox[{"a3", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "b", ",", " ", "d"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"c", ",", " ", "e", ",", " ", "b"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"f", ",", " ", "c", ",", " ", "a"}], "}"}]}], "}"}]}], ";", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"MatrixForm", "[", "j3", "]"}], ",", " ", 
    RowBox[{"MatrixForm", "[", "a3", "]"}]}], "}"}]}]], "Input",
 CellLabel->"In[61]:=",ExpressionUUID->"df981a7d-cbc9-e246-af20-4164717df7fe"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   TagBox[
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {"0", "0", "1"},
       {"0", "1", "0"},
       {"1", "0", "0"}
      },
      GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.7]}, 
          Offset[0.27999999999999997`]}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}}], "\[NoBreak]", ")"}],
    Function[BoxForm`e$, 
     MatrixForm[BoxForm`e$]]], ",", 
   TagBox[
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {"a", "b", "d"},
       {"c", "e", "b"},
       {"f", "c", "a"}
      },
      GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.7]}, 
          Offset[0.27999999999999997`]}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}}], "\[NoBreak]", ")"}],
    Function[BoxForm`e$, 
     MatrixForm[BoxForm`e$]]]}], "}"}]], "Output",
 CellChangeTimes->{3.999412264909231*^9, 3.9994337800526505`*^9},
 CellLabel->"Out[61]=",ExpressionUUID->"51362344-5fbf-554c-9f3a-7d00f83e0646"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Simplify", "[", 
    RowBox[{"a3", " ", "==", " ", 
     RowBox[{"j3", ".", 
      RowBox[{"Transpose", "[", "a3", "]"}], ".", "j3"}]}], "]"}], ",", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"j3", ".", "a3"}], " ", "==", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"j3", ".", "a3"}], "]"}]}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[62]:=",ExpressionUUID->"8d2053eb-001f-6d46-afac-ac5fa470b737"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellChangeTimes->{3.999412265039192*^9, 3.999433780077652*^9},
 CellLabel->"Out[62]=",ExpressionUUID->"15d0b2a0-6f6f-f74c-820f-0bb0e4833b1c"]
}, Open  ]],

Cell["\<\
The two identities verify persymmetry and its equivalent formulation through \
JA. Thus the real persymmetric matrices of order 3 form a six-dimensional \
linear subspace.\
\>", "Text",ExpressionUUID->"d3ca4893-e656-7f4e-8cc5-4ac16864d353"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Characteristic polynomial", "Section",ExpressionUUID->"82cd4f98-13c2-e64e-92d9-d11cca88662d"],

Cell["\<\
Set \[Chi](x) = det(xI - A). Mathematica's CharacteristicPolynomial[A, x] \
uses det(A - xI), so its output is -\[Chi](x) in dimension 3. The final \
equality below checks this sign convention.\
\>", "Text",ExpressionUUID->"78d4e409-2b16-5141-a7d8-f01bc429fbdc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"chi", " ", "=", " ", 
   RowBox[{"Expand", "[", 
    RowBox[{"Det", "[", 
     RowBox[{
      RowBox[{"x", " ", 
       RowBox[{"IdentityMatrix", "[", "3", "]"}]}], " ", "-", " ", "a3"}], 
     "]"}], "]"}]}], ";", " ", "chi"}]], "Input",
 CellLabel->"In[63]:=",ExpressionUUID->"e487e725-542f-0148-91dd-a1bdcd706c03"],

Cell[BoxData[
 RowBox[{
  RowBox[{"2", " ", "a", " ", "b", " ", "c"}], "-", 
  RowBox[{
   SuperscriptBox["c", "2"], " ", "d"}], "-", 
  RowBox[{
   SuperscriptBox["a", "2"], " ", "e"}], "-", 
  RowBox[{
   SuperscriptBox["b", "2"], " ", "f"}], "+", 
  RowBox[{"d", " ", "e", " ", "f"}], "+", 
  RowBox[{
   SuperscriptBox["a", "2"], " ", "x"}], "-", 
  RowBox[{"2", " ", "b", " ", "c", " ", "x"}], "+", 
  RowBox[{"2", " ", "a", " ", "e", " ", "x"}], "-", 
  RowBox[{"d", " ", "f", " ", "x"}], "-", 
  RowBox[{"2", " ", "a", " ", 
   SuperscriptBox["x", "2"]}], "-", 
  RowBox[{"e", " ", 
   SuperscriptBox["x", "2"]}], "+", 
  SuperscriptBox["x", "3"]}]], "Output",
 CellChangeTimes->{3.9994122650421925`*^9, 3.999433780101652*^9},
 CellLabel->"Out[63]=",ExpressionUUID->"31242fd8-8072-fb44-9aee-1e5184ef69d6"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"detA", " ", "=", " ", 
   RowBox[{"Factor", "[", 
    RowBox[{"Det", "[", "a3", "]"}], "]"}]}], ";", " ", 
  RowBox[{"expected", " ", "=", " ", 
   RowBox[{
    RowBox[{"x", "^", "3"}], " ", "-", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", "a"}], " ", "+", " ", "e"}], ")"}], " ", 
     RowBox[{"x", "^", "2"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"a", "^", "2"}], " ", "+", " ", 
       RowBox[{"2", " ", "a", " ", "e"}], " ", "-", " ", 
       RowBox[{"2", " ", "b", " ", "c"}], " ", "-", " ", 
       RowBox[{"d", " ", "f"}]}], ")"}], " ", "x"}], " ", "-", " ", 
    "detA"}]}], ";", " ", 
  RowBox[{"{", 
   RowBox[{"detA", ",", " ", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"chi", " ", "==", " ", "expected"}], "]"}], ",", " ", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"chi", " ", "==", " ", 
      RowBox[{"-", 
       RowBox[{"CharacteristicPolynomial", "[", 
        RowBox[{"a3", ",", " ", "x"}], "]"}]}]}], "]"}]}], "}"}]}]], "Input",
 CellLabel->"In[64]:=",ExpressionUUID->"a136f298-1140-d841-84b1-79e2ce408593"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"-", "2"}], " ", "a", " ", "b", " ", "c"}], "+", 
    RowBox[{
     SuperscriptBox["c", "2"], " ", "d"}], "+", 
    RowBox[{
     SuperscriptBox["a", "2"], " ", "e"}], "+", 
    RowBox[{
     SuperscriptBox["b", "2"], " ", "f"}], "-", 
    RowBox[{"d", " ", "e", " ", "f"}]}], ",", "True", ",", "True"}], 
  "}"}]], "Output",
 CellChangeTimes->{3.999412265069193*^9, 3.9994337801451626`*^9},
 CellLabel->"Out[64]=",ExpressionUUID->"12723f51-69ff-6245-8654-3aa60c7ecfd0"]
}, Open  ]],

Cell["Collecting coefficients gives", "Text",ExpressionUUID->"f4896396-a751-bd46-8555-15861c36f198"],

Cell["\[Chi](x) = x\.b3 - (2a + e)x\.b2 + (a\.b2 + 2ae - 2bc - df)x - \
det(A),", "DisplayFormula",ExpressionUUID->"7bd463a1-c05c-ac46-86dd-\
2d26fd77c5ef"],

Cell["det(A) = a\.b2e - 2abc + b\.b2f + c\.b2d - def.", "DisplayFormula",ExpressionUUID->"41a99f91-f141-5b41-99f6-fb249573a9a5"],

Cell["\<\
Here 2a + e is the trace, while a\.b2 + 2ae - 2bc - df is the sum of the \
principal minors of order 2. The symbolic checks confirm the expansion and \
the overall sign.\
\>", "Text",ExpressionUUID->"4ffaa211-861c-2f49-8c05-913fc0ed9e95"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Characterisation of \[Chi](x) = x\.b3", "Section",ExpressionUUID->"fca02a8f-d68e-ea41-b14a-f90bc91b662b"],

Cell["\<\
Equating the constant, linear and quadratic coefficients to zero gives the \
following system. Eliminating e through the trace condition yields e = -2a.\
\>", "Text",ExpressionUUID->"33efc4b2-4f32-d04a-a8f6-b972cc685fb2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"coefficientEquations", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Coefficient", "[", 
       RowBox[{"chi", ",", " ", "x", ",", " ", "k"}], "]"}], " ", "==", " ", 
      "0"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"coefficientEquations", " ", "//", " ", "TableForm"}]}]], "Input",
 CellLabel->"In[65]:=",ExpressionUUID->"2ef5a794-2c66-af47-bf21-f77c640573aa"],

Cell[BoxData[
 TagBox[
  TagBox[GridBox[{
     {
      RowBox[{
       RowBox[{
        RowBox[{"2", " ", "a", " ", "b", " ", "c"}], "-", 
        RowBox[{
         SuperscriptBox["c", "2"], " ", "d"}], "-", 
        RowBox[{
         SuperscriptBox["a", "2"], " ", "e"}], "-", 
        RowBox[{
         SuperscriptBox["b", "2"], " ", "f"}], "+", 
        RowBox[{"d", " ", "e", " ", "f"}]}], "\[Equal]", "0"}]},
     {
      RowBox[{
       RowBox[{
        SuperscriptBox["a", "2"], "-", 
        RowBox[{"2", " ", "b", " ", "c"}], "+", 
        RowBox[{"2", " ", "a", " ", "e"}], "-", 
        RowBox[{"d", " ", "f"}]}], "\[Equal]", "0"}]},
     {
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"-", "2"}], " ", "a"}], "-", "e"}], "\[Equal]", "0"}]}
    },
    GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.5599999999999999]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}],
   Column],
  Function[BoxForm`e$, 
   TableForm[BoxForm`e$]]]], "Output",
 CellChangeTimes->{3.9994122650727005`*^9, 3.999433780148163*^9},
 CellLabel->
  "Out[65]//TableForm=",ExpressionUUID->"b1812b8a-9208-4943-8911-\
488bf70bbbd1"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"traceRule", " ", "=", " ", 
   RowBox[{"e", " ", "->", " ", 
    RowBox[{
     RowBox[{"-", "2"}], " ", "a"}]}]}], ";", " ", 
  RowBox[{"reducedPolynomial", " ", "=", " ", 
   RowBox[{"Expand", "[", 
    RowBox[{"chi", " ", "/.", " ", "traceRule"}], "]"}]}], ";", " ", 
  "reducedPolynomial"}]], "Input",
 CellLabel->"In[66]:=",ExpressionUUID->"bf4d26b7-3c67-f14f-b4c9-3033f356be00"],

Cell[BoxData[
 RowBox[{
  RowBox[{"2", " ", 
   SuperscriptBox["a", "3"]}], "+", 
  RowBox[{"2", " ", "a", " ", "b", " ", "c"}], "-", 
  RowBox[{
   SuperscriptBox["c", "2"], " ", "d"}], "-", 
  RowBox[{
   SuperscriptBox["b", "2"], " ", "f"}], "-", 
  RowBox[{"2", " ", "a", " ", "d", " ", "f"}], "-", 
  RowBox[{"3", " ", 
   SuperscriptBox["a", "2"], " ", "x"}], "-", 
  RowBox[{"2", " ", "b", " ", "c", " ", "x"}], "-", 
  RowBox[{"d", " ", "f", " ", "x"}], "+", 
  SuperscriptBox["x", "3"]}]], "Output",
 CellChangeTimes->{3.9994122650747013`*^9, 3.999433780151163*^9},
 CellLabel->"Out[66]=",ExpressionUUID->"9b9a2500-ecf4-ba45-ad9e-80afa06bf5e9"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"nilpotentConditions", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"e", " ", "==", " ", 
      RowBox[{
       RowBox[{"-", "2"}], " ", "a"}]}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"3", " ", 
        RowBox[{"a", "^", "2"}]}], " ", "+", " ", 
       RowBox[{"2", " ", "b", " ", "c"}], " ", "+", " ", 
       RowBox[{"d", " ", "f"}]}], " ", "==", " ", "0"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], " ", 
        RowBox[{"a", "^", "3"}]}], " ", "-", " ", 
       RowBox[{"2", " ", "a", " ", "b", " ", "c"}], " ", "+", " ", 
       RowBox[{
        RowBox[{"b", "^", "2"}], " ", "f"}], " ", "+", " ", 
       RowBox[{
        RowBox[{"c", "^", "2"}], " ", "d"}], " ", "+", " ", 
       RowBox[{"2", " ", "a", " ", "d", " ", "f"}]}], " ", "==", " ", "0"}]}],
     "}"}]}], ";", " ", 
  RowBox[{"nilpotentConditions", " ", "//", " ", "TableForm"}]}]], "Input",
 CellLabel->"In[67]:=",ExpressionUUID->"80364bb0-e1ed-9747-9c71-f50318f1e5c4"],

Cell[BoxData[
 TagBox[
  TagBox[GridBox[{
     {
      RowBox[{"e", "\[Equal]", 
       RowBox[{
        RowBox[{"-", "2"}], " ", "a"}]}]},
     {
      RowBox[{
       RowBox[{
        RowBox[{"3", " ", 
         SuperscriptBox["a", "2"]}], "+", 
        RowBox[{"2", " ", "b", " ", "c"}], "+", 
        RowBox[{"d", " ", "f"}]}], "\[Equal]", "0"}]},
     {
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"-", "2"}], " ", 
         SuperscriptBox["a", "3"]}], "-", 
        RowBox[{"2", " ", "a", " ", "b", " ", "c"}], "+", 
        RowBox[{
         SuperscriptBox["c", "2"], " ", "d"}], "+", 
        RowBox[{
         SuperscriptBox["b", "2"], " ", "f"}], "+", 
        RowBox[{"2", " ", "a", " ", "d", " ", "f"}]}], "\[Equal]", "0"}]}
    },
    GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.5599999999999999]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}],
   Column],
  Function[BoxForm`e$, 
   TableForm[BoxForm`e$]]]], "Output",
 CellChangeTimes->{3.9994122650776997`*^9, 3.9994337801541634`*^9},
 CellLabel->
  "Out[67]//TableForm=",ExpressionUUID->"8c77291f-031a-c944-9f30-\
e45ad1f96969"]
}, Open  ]],

Cell["\<\
These three equations are necessary and sufficient for \[Chi](x) = x\.b3. By \
Cayley\[Dash]Hamilton they imply A\.b3 = 0; conversely, A\.b3 = 0 forces all \
eigenvalues to vanish. The trace condition alone is insufficient.\
\>", "Text",ExpressionUUID->"e81cf6a9-1509-9a41-baf0-3e7339e270a9"],

Cell["\<\
For constructing examples, substitution of df = -3a\.b2 - 2bc into the \
determinant condition gives the equivalent system\
\>", "Text",ExpressionUUID->"28817342-e11d-4a4c-9413-8b10419c2523"],

Cell["e = -2a,     df = -3a\.b2 - 2bc,     b\.b2f + c\.b2d = 8a\.b3 + 6abc.", \
"DisplayFormula",ExpressionUUID->"a477fb9b-b6d4-0c4b-a5ae-8dce7f0cacae"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. A nonnegative example", "Section",ExpressionUUID->"9697fc11-6f61-0f46-ade5-d6b3e832b0f1"],

Cell["\<\
The upper shift U provides a nonnegative persymmetric realisation of the \
spectrum {0, 0, 0}. The output records U, the persymmetry check, its \
characteristic polynomial, U\.b2 and U\.b3.\
\>", "Text",ExpressionUUID->"cf3b6caa-bc66-ec4c-b30a-281644f3ef43"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"upperShift", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "1", ",", " ", "0"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}]}], "}"}]}], ";", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"MatrixForm", "[", "upperShift", "]"}], ",", " ", 
    RowBox[{"Simplify", "[", 
     RowBox[{"upperShift", " ", "==", " ", 
      RowBox[{"j3", ".", 
       RowBox[{"Transpose", "[", "upperShift", "]"}], ".", "j3"}]}], "]"}], ",",
     " ", 
    RowBox[{"Expand", "[", 
     RowBox[{"Det", "[", 
      RowBox[{
       RowBox[{"x", " ", 
        RowBox[{"IdentityMatrix", "[", "3", "]"}]}], " ", "-", " ", 
       "upperShift"}], "]"}], "]"}], ",", " ", 
    RowBox[{"MatrixForm", "[", 
     RowBox[{"MatrixPower", "[", 
      RowBox[{"upperShift", ",", " ", "2"}], "]"}], "]"}], ",", " ", 
    RowBox[{"MatrixForm", "[", 
     RowBox[{"MatrixPower", "[", 
      RowBox[{"upperShift", ",", " ", "3"}], "]"}], "]"}]}], "}"}]}]], "Input",
 CellLabel->"In[68]:=",ExpressionUUID->"a6b96357-457f-9c48-9278-dfb239945c76"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   TagBox[
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {"0", "1", "0"},
       {"0", "0", "1"},
       {"0", "0", "0"}
      },
      GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.7]}, 
          Offset[0.27999999999999997`]}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}}], "\[NoBreak]", ")"}],
    Function[BoxForm`e$, 
     MatrixForm[BoxForm`e$]]], ",", "True", ",", 
   SuperscriptBox["x", "3"], ",", 
   TagBox[
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {"0", "0", "1"},
       {"0", "0", "0"},
       {"0", "0", "0"}
      },
      GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.7]}, 
          Offset[0.27999999999999997`]}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}}], "\[NoBreak]", ")"}],
    Function[BoxForm`e$, 
     MatrixForm[BoxForm`e$]]], ",", 
   TagBox[
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {"0", "0", "0"},
       {"0", "0", "0"},
       {"0", "0", "0"}
      },
      GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.7]}, 
          Offset[0.27999999999999997`]}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}}], "\[NoBreak]", ")"}],
    Function[BoxForm`e$, 
     MatrixForm[BoxForm`e$]]]}], "}"}]], "Output",
 CellChangeTimes->{3.9994122651076984`*^9, 3.999433780179161*^9},
 CellLabel->"Out[68]=",ExpressionUUID->"207ef9a8-d969-bd43-b26f-e283f9beec65"]
}, Open  ]],

Cell["\<\
Upper triangularity gives \[Chi](x) = x\.b3. Since U\.b2 has a nonzero (1,3) \
entry and U\.b3 = 0, its minimal polynomial is x\.b3 and its nilpotency index \
is 3.\
\>", "Text",ExpressionUUID->"11ed8882-764a-c44f-8568-2087e45bee7d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Signed cycles can cancel", "Section",ExpressionUUID->"d2818eec-0eec-4e4f-9c15-50ec989c6274"],

Cell["\<\
Consider the signed persymmetric matrix M below. The output verifies \
\[Chi](x) = x\.b3, M\.b2 \[NotEqual] 0 and M\.b3 = 0, so M has nilpotency \
index 3 despite the directed cycles in its nonzero pattern.\
\>", "Text",ExpressionUUID->"198eee8a-8752-b442-b00c-27957e169765"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"mixedCycles", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "1", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "4"}], ",", " ", "2", ",", " ", "0"}], "}"}]}], "}"}]}], ";",
   " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"MatrixForm", "[", "mixedCycles", "]"}], ",", " ", 
    RowBox[{"Simplify", "[", 
     RowBox[{"mixedCycles", " ", "==", " ", 
      RowBox[{"j3", ".", 
       RowBox[{"Transpose", "[", "mixedCycles", "]"}], ".", "j3"}]}], "]"}], ",",
     " ", 
    RowBox[{"Expand", "[", 
     RowBox[{"Det", "[", 
      RowBox[{
       RowBox[{"x", " ", 
        RowBox[{"IdentityMatrix", "[", "3", "]"}]}], " ", "-", " ", 
       "mixedCycles"}], "]"}], "]"}], ",", " ", 
    RowBox[{"MatrixForm", "[", 
     RowBox[{"MatrixPower", "[", 
      RowBox[{"mixedCycles", ",", " ", "2"}], "]"}], "]"}], ",", " ", 
    RowBox[{"MatrixForm", "[", 
     RowBox[{"MatrixPower", "[", 
      RowBox[{"mixedCycles", ",", " ", "3"}], "]"}], "]"}]}], 
   "}"}]}]], "Input",
 CellLabel->"In[69]:=",ExpressionUUID->"9cfaaabb-8dcd-7142-b164-b6f7ce95fc34"],

