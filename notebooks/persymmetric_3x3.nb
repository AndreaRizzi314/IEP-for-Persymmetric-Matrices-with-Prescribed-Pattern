}, Open  ]],

Cell[CellGroupData[{

Cell["Cancellation in the characteristic coefficients", "Subsection",ExpressionUUID->"0f149bda-7af7-1941-bff4-8b1362faeabb"],

Cell["\<\
For the general zero-diagonal persymmetric matrix, the expression in section \
2 reduces to\
\>", "Text",ExpressionUUID->"36d4eaf0-6d54-c84d-bbda-e5c0b7df9c96"],

Cell["\[Chi](x) = x\.b3 - (2bc + df)x - (b\.b2f + c\.b2d).", "DisplayFormula",ExpressionUUID->"0aa092bf-7562-de4e-aa62-c84613ac1500"],

Cell["\<\
For M, the products associated with the three directed 2-cycles and the two \
directed 3-cycles satisfy\
\>", "Text",ExpressionUUID->"85eb1256-4241-0546-81cb-db87483a8c53"],

Cell["2bc + df = (1 \[Times] 2) + (1 \[Times] 2) + (1 \[Times] (-4)) = 0,", \
"DisplayFormula",ExpressionUUID->"44e931d7-8eed-ac4c-bb35-2c34488d251b"],

Cell["b\.b2f + c\.b2d = (1 \[Times] 1 \[Times] (-4)) + (1 \[Times] 2 \[Times] \
2) = 0.", "DisplayFormula",ExpressionUUID->"af81a735-1652-7743-8db6-\
236ab323859e"],

Cell["\<\
Together with the zero trace, these cancellations account for every \
coefficient below x\.b3. The sign pattern displayed next is realised by a \
nilpotent matrix, but does not force nilpotency for every choice of \
magnitudes.\
\>", "Text",ExpressionUUID->"6a648638-1189-af4f-99f9-343cd4ac46bf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"signPattern", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Which", "[", 
       RowBox[{
        RowBox[{"#", " ", ">", " ", "0"}], ",", " ", "\"\<+\>\"", ",", " ", 
        RowBox[{"#", " ", "<", " ", "0"}], ",", " ", "\"\<-\>\"", ",", " ", 
        "True", ",", " ", "\"\<0\>\""}], "]"}], " ", "&"}], ",", " ", 
     "mixedCycles", ",", " ", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"Grid", "[", 
   RowBox[{"signPattern", ",", " ", 
    RowBox[{"Frame", " ", "->", " ", "All"}]}], "]"}]}]], "Input",
 CellLabel->"In[70]:=",ExpressionUUID->"6358cb49-ca34-2740-9bf7-0bb936f86bd3"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"0\"\>", "\<\"+\"\>", "\<\"+\"\>"},
    {"\<\"+\"\>", "\<\"0\"\>", "\<\"+\"\>"},
    {"\<\"-\"\>", "\<\"+\"\>", "\<\"0\"\>"}
   },
   AutoDelete->False,
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",
 CellChangeTimes->{3.9994122651386986`*^9, 3.999433780186165*^9},
 CellLabel->"Out[70]=",ExpressionUUID->"79dd7e83-e3b9-9344-b460-2435e95a7df7"]
}, Open  ]],

Cell["\<\
For example, replacing the (3,1) entry -4 by -3 preserves both persymmetry \
and the sign pattern, but changes the characteristic polynomial to x\.b3 - x \
- 1.\
\>", "Text",ExpressionUUID->"0115991f-8a54-3e42-972a-2f15ede8faf0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The directed nonzero pattern", "Subsection",ExpressionUUID->"ff8039e8-7049-ba4b-8f3c-bd3559713a0d"],

Cell["\<\
For any square matrix B, define G(B) on the matrix indices by i \[RightArrow] \
j exactly when the (i,j) entry is nonzero, including loops for nonzero \
diagonal entries. The following graph records this pattern for M; it does not \
encode edge signs or magnitudes.\
\>", "Text",ExpressionUUID->"6027b80d-01cc-4545-8cc9-5e2d3820e419"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"adjacency", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Boole", "[", 
       RowBox[{"#", " ", "!=", " ", "0"}], "]"}], " ", "&"}], ",", " ", 
     "mixedCycles", ",", " ", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], ";", " ", 
  RowBox[{"AdjacencyGraph", "[", 
   RowBox[{"adjacency", ",", " ", 
    RowBox[{"DirectedEdges", " ", "->", " ", "True"}], ",", " ", 
    RowBox[{"VertexLabels", " ", "->", " ", "\"\<Name\>\""}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[71]:=",ExpressionUUID->"c6f7be2a-8357-d54d-a863-2d425fe83169"],

