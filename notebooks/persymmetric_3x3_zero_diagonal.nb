Cell[CellGroupData[{

Cell["3. Characteristic polynomial and Cayley-Hamilton", "Section",ExpressionUUID->"0b89ab57-aae7-f540-aa3f-022fa926b84f"],

Cell["\<\
Nilpotency requires all three eigenvalues to be zero, so the characteristic \
polynomial must be x^3. The coefficient of x^2 is already zero because the \
diagonal is zero. The remaining two coefficients give exactly the equations \
found by multiplication.\
\>", "Text",
 CellChangeTimes->{{4.0003771655851517`*^9, 
  4.0003771915610123`*^9}},ExpressionUUID->"cd96fbd1-b36c-6041-bdaa-\
9ebd53979f5d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"chi", "=", 
   RowBox[{"Expand", "[", 
    RowBox[{"monicChar", "[", 
     RowBox[{"aMatrix", ",", "x"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"recordCheck", "[", 
   RowBox[{"\"\<Characteristic polynomial\>\"", ",", "chi", ",", 
    RowBox[{"Expand", "[", 
     RowBox[{
      SuperscriptBox["x", "3"], "-", 
      RowBox[{"p2", " ", "x"}], "-", "q3"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"recordCheck", "[", 
   RowBox[{"\"\<Wolfram characteristic polynomial sign convention\>\"", ",", 
    RowBox[{"Expand", "[", 
     RowBox[{"-", 
      RowBox[{"CharacteristicPolynomial", "[", 
       RowBox[{"aMatrix", ",", "x"}], "]"}]}], "]"}], ",", "chi"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"recordCheck", "[", 
   RowBox[{"\"\<Trace is zero\>\"", ",", 
    RowBox[{"Tr", "[", "aMatrix", "]"}], ",", "0"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"recordCheck", "[", 
   RowBox[{"\"\<Determinant is q\>\"", ",", 
    RowBox[{"Expand", "[", 
     RowBox[{"Det", "[", "aMatrix", "]"}], "]"}], ",", "q3"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"recordCheck", "[", 
   RowBox[{"\"\<Trace of square is 2p\>\"", ",", 
    RowBox[{"Expand", "[", 
     RowBox[{"Tr", "[", "aSquare", "]"}], "]"}], ",", 
    RowBox[{"Expand", "[", 
     RowBox[{"2", " ", "p2"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"recordCheck", "[", 
   RowBox[{"\"\<Trace of cube is 3q\>\"", ",", 
    RowBox[{"Expand", "[", 
     RowBox[{"Tr", "[", "aCube", "]"}], "]"}], ",", 
    RowBox[{"Expand", "[", 
     RowBox[{"3", " ", "q3"}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 TagBox[GridBox[{
    {"\"\<Characteristic polynomial\>\"", "chi"},
    {"\"\<Trace(A^2)\>\"", 
     RowBox[{"Expand", "[", 
      RowBox[{"Tr", "[", "aSquare", "]"}], "]"}]},
    {"\"\<Trace(A^3)\>\"", 
     RowBox[{"Expand", "[", 
      RowBox[{"Tr", "[", "aCube", "]"}], "]"}]}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]}], "Input",
 InitializationCell->False,
 CellLabel->
  "In[355]:=",ExpressionUUID->"9151e29d-1d25-7e47-b8c4-a359c482db13"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"Characteristic polynomial\"\>", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["c", "2"]}], " ", "d"}], "-", 
      RowBox[{
       SuperscriptBox["b", "2"], " ", "f"}], "-", 
      RowBox[{"2", " ", "b", " ", "c", " ", "x"}], "-", 
      RowBox[{"d", " ", "f", " ", "x"}], "+", 
      SuperscriptBox["x", "3"]}]},
    {"\<\"Trace(A^2)\"\>", 
     RowBox[{
      RowBox[{"4", " ", "b", " ", "c"}], "+", 
      RowBox[{"2", " ", "d", " ", "f"}]}]},
    {"\<\"Trace(A^3)\"\>", 
     RowBox[{
      RowBox[{"3", " ", 
       SuperscriptBox["c", "2"], " ", "d"}], "+", 
      RowBox[{"3", " ", 
       SuperscriptBox["b", "2"], " ", "f"}]}]}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",
 CellChangeTimes->{{4.0004397111014404`*^9, 4.0004397543365116`*^9}, 
   4.0004399617433643`*^9, {4.0004400182824306`*^9, 4.0004400421854362`*^9}},
 CellLabel->
  "Out[362]=",ExpressionUUID->"79d3aad0-5698-6a4d-a383-3c2c678f30db"]
}, Open  ]],

Cell["\<\
Cayley-Hamilton replaces x^3 by A^3, -p x by -p A, and the constant -q by -q \
I. It therefore gives A^3 - p A - q I = 0, consistent with our direct \
multiplication. Zero trace by itself is insufficient: every matrix in this \
family has zero trace, including many matrices that are not nilpotent.\
\>", "Text",ExpressionUUID->"f99fa123-6352-b943-acb6-52bd372e3896"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"traceCounterexample", "=", 
   RowBox[{"mat", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"recordCheck", "[", 
   RowBox[{"\"\<Zero trace counterexample is not nilpotent\>\"", ",", 
    RowBox[{"zeroMatrixQ", "[", 
     RowBox[{"MatrixPower", "[", 
      RowBox[{"traceCounterexample", ",", "3"}], "]"}], "]"}], ",", "False"}],
    "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"MatrixForm", "[", "traceCounterexample", "]"}], ",", 
   RowBox[{"monicChar", "[", 
    RowBox[{"traceCounterexample", ",", "x"}], "]"}], ",", 
   RowBox[{"MatrixForm", "[", RowBox[{"MatrixPower", "[", 
     RowBox[{"traceCounterexample", ",", "3"}], "]"}], "]"}]}], "}"}]}], "Input",
 InitializationCell->False,
 CellLabel->
  "In[363]:=",ExpressionUUID->"f8b41e10-dfd5-1d44-bd17-96b1a7441575"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   TagBox[RowBox[{"(", "\:2060", GridBox[{{"0", "1", "1"}, {"1", "0", "1"}, {"1", "1", "0"}}, RowSpacings -> 1, ColumnSpacings -> 1, RowAlignments -> Baseline, ColumnAlignments -> Center], "\:2060", ")"}], Function[BoxForm`e$, MatrixForm[BoxForm`e$]]], ",", 
   RowBox[{
    RowBox[{"-", "2"}], "-", 
    RowBox[{"3", " ", "x"}], "+", 
    SuperscriptBox["x", "3"]}], ",", 
   TagBox[RowBox[{"(", "\:2060", GridBox[{{"2", "3", "3"}, {"3", "2", "3"}, {"3", "3", "2"}}, RowSpacings -> 1, ColumnSpacings -> 1, RowAlignments -> Baseline, ColumnAlignments -> Center], "\:2060", ")"}], Function[BoxForm`e$, MatrixForm[BoxForm`e$]]]}], "}"}]], "Output",
 CellChangeTimes->{{4.00043971110544*^9, 4.0004397543415127`*^9}, 
   4.0004399617483654`*^9, {4.000440018285431*^9, 4.0004400421884365`*^9}},
 CellLabel->
  "Out[365]=",ExpressionUUID->"47bfb9dc-93cc-2342-9ffb-57cfd2a93992"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Fully solve the case b,c,d,f all nonzero", "Section",ExpressionUUID->"11877ee0-e171-1748-b969-b7e9e3700e47"],

Cell["\<\
We can divide by b, c and d in this section because they are explicitly \
nonzero. From b^2 f + c^2 d = 0, solve for f. Substituting that expression \
into 2bc + df = 0 leaves one relation between b,c,d.\
\>", "Text",ExpressionUUID->"9fd5ba42-42e6-c64f-86d0-005beb3d67cc"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{"f", "\[LongEqual]", 
    RowBox[{"-", 
     FractionBox[
      RowBox[{
       SuperscriptBox["c", "2"], " ", "d"}], 
      SuperscriptBox["b", "2"]]}]}],
   HoldForm], TraditionalForm]], "DisplayFormula",ExpressionUUID->"3fd2662a-\
264e-664f-99a6-8e82ac61a529"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    RowBox[{
     RowBox[{"2", " ", "b", " ", "c"}], "-", 
     FractionBox[
      RowBox[{
       SuperscriptBox["c", "2"], " ", 
       SuperscriptBox["d", "2"]}], 
      SuperscriptBox["b", "2"]]}], "\[LongEqual]", "0"}],
   HoldForm], TraditionalForm]], "DisplayFormula",ExpressionUUID->"8935399d-\
9265-9c40-900b-899ca5eec2a0"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    RowBox[{"c", " ", 
     SuperscriptBox["d", "2"]}], "\[LongEqual]", 
    RowBox[{"2", " ", 
     SuperscriptBox["b", "3"]}]}],
   HoldForm], TraditionalForm]], "DisplayFormula",ExpressionUUID->"5c5c3bef-\
a057-5848-8366-f6629f345c14"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"eliminated", "=", 
   RowBox[{"Factor", "[", 
    RowBox[{"p2", "/.", "\[VeryThinSpace]", 
     RowBox[{"f", "\[Rule]", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{
         SuperscriptBox["c", "2"], " ", "d"}], 
        SuperscriptBox["b", "2"]]}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"recordCheck", "[", 
   RowBox[{"\"\<Eliminated equation factors as expected\>\"", ",", 
    RowBox[{"Together", "[", 
     RowBox[{"eliminated", "-", 
      FractionBox[
       RowBox[{"c", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", 
           SuperscriptBox["b", "3"]}], "-", 
          RowBox[{"c", " ", 
           SuperscriptBox["d", "2"]}]}], ")"}]}], 
       SuperscriptBox["b", "2"]]}], "]"}], ",", "0"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{"eliminated", ",", 
   RowBox[{"Reduce", "[", 
    RowBox[{
     RowBox[{"nilConditions", "&&", 
      RowBox[{
       RowBox[{"b", " ", "c", " ", "d", " ", "f"}], "\[NotEqual]", "0"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"c", ",", "f"}], "}"}], ",", 
     TemplateBox[{},
      "Reals"]}], "]"}]}], "}"}]}], "Input",
 InitializationCell->False,
 CellLabel->
  "In[366]:=",ExpressionUUID->"09668386-d225-1a4b-ba25-974893f2f475"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox[
    RowBox[{"c", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", 
        SuperscriptBox["b", "3"]}], "-", 
       RowBox[{"c", " ", 
        SuperscriptBox["d", "2"]}]}], ")"}]}], 
    SuperscriptBox["b", "2"]], ",", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"d", "<", "0"}], "&&", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"b", "<", "0"}], "&&", 
            RowBox[{"c", "\[Equal]", 
             FractionBox[
              RowBox[{"2", " ", 
               SuperscriptBox["b", "3"]}], 
              SuperscriptBox["d", "2"]]}]}], ")"}], "||", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"b", ">", "0"}], "&&", 
            RowBox[{"c", "\[Equal]", 
             FractionBox[
              RowBox[{"2", " ", 
               SuperscriptBox["b", "3"]}], 
              SuperscriptBox["d", "2"]]}]}], ")"}]}], ")"}]}], ")"}], "||", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"d", ">", "0"}], "&&", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"b", "<", "0"}], "&&", 
            RowBox[{"c", "\[Equal]", 
             FractionBox[
              RowBox[{"2", " ", 
               SuperscriptBox["b", "3"]}], 
              SuperscriptBox["d", "2"]]}]}], ")"}], "||", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"b", ">", "0"}], "&&", 
            RowBox[{"c", "\[Equal]", 
             FractionBox[
              RowBox[{"2", " ", 
               SuperscriptBox["b", "3"]}], 
              SuperscriptBox["d", "2"]]}]}], ")"}]}], ")"}]}], ")"}]}], ")"}],
     "&&", 
    RowBox[{"f", "\[Equal]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"2", " ", "b", " ", "c"}], "d"]}]}]}]}], "}"}]], "Output",
 CellChangeTimes->{{4.0004397111244392`*^9, 4.000439754361511*^9}, 
   4.0004399625009346`*^9, {4.0004400183054295`*^9, 4.0004400421954403`*^9}},
 CellLabel->
  "Out[368]=",ExpressionUUID->"f124940d-8817-6a4a-8fbf-4969925cbad6"]
}, Open  ]],

Cell["\<\
Choose b and d freely, provided both are nonzero. Then c and f are uniquely \
determined. This gives EVERY all-nonzero nilpotent matrix in the family, not \
just some examples.\
\>", "Text",ExpressionUUID->"5368a143-d5e9-4241-94bb-ee15d5fec757"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{"c", "\[LongEqual]", 
    FractionBox[
     RowBox[{"2", " ", 
      SuperscriptBox["b", "3"]}], 
     SuperscriptBox["d", "2"]]}],
   HoldForm], TraditionalForm]], "DisplayFormula",ExpressionUUID->"6d52362c-\
f37d-9041-8938-08373e6b5f6e"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{"f", "\[LongEqual]", 
    RowBox[{"-", 
     FractionBox[
      RowBox[{"4", " ", 
       SuperscriptBox["b", "4"]}], 
      SuperscriptBox["d", "3"]]}]}],
   HoldForm], TraditionalForm]], "DisplayFormula",ExpressionUUID->"8ead9227-\
f141-244c-9a56-2cd45e939594"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"denseRules", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"c", "\[Rule]", 
      FractionBox[
       RowBox[{"2", " ", 
        SuperscriptBox["b", "3"]}], 
       SuperscriptBox["d", "2"]]}], ",", 
     RowBox[{"f", "\[Rule]", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{"4", " ", 
         SuperscriptBox["b", "4"]}], 
        SuperscriptBox["d", "3"]]}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"denseMatrix", "=", 
   RowBox[{"aMatrix", "/.", "\[VeryThinSpace]", "denseRules"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"denseAssumptions", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"b", ",", "d"}], "}"}], "\[Element]", 
     TemplateBox[{},
      "Reals"]}], "&&", 
    RowBox[{"b", "\[NotEqual]", "0"}], "&&", 
    RowBox[{"d", "\[NotEqual]", "0"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"denseFormulaConditions", "=", 
   RowBox[{
    RowBox[{"c", "\[Equal]", 
     FractionBox[
      RowBox[{"2", " ", 
       SuperscriptBox["b", "3"]}], 
      SuperscriptBox["d", "2"]]}], "&&", 
    RowBox[{"f", "\[Equal]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"4", " ", 
        SuperscriptBox["b", "4"]}], 
       SuperscriptBox["d", "3"]]}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"denseCompleteness", "=", 
   RowBox[{"Resolve", "[", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[ForAll]", 
       RowBox[{"{", 
        RowBox[{"b", ",", "c", ",", "d", ",", "f"}], "}"}]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"b", " ", "c", " ", "d", " ", "f"}], "\[NotEqual]", "0"}], "\[Implies]", 
        RowBox[{
        "nilConditions", "\[Equivalent]", "denseFormulaConditions"}]}], 
       ")"}]}], ",", 
     TemplateBox[{},
      "Reals"]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"recordCheck", "[", 
   RowBox[{"\"\<Dense parameterization is complete\>\"", ",", 
    "denseCompleteness", ",", "True"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"recordCheck", "[", 
   RowBox[{"\"\<Dense formula has zero cube\>\"", ",", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"MatrixPower", "[", 
       RowBox[{"denseMatrix", ",", "3"}], "]"}], ",", "denseAssumptions"}], 
     "]"}], ",", "zero3"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"recordCheck", "[", 
   RowBox[{"\"\<Dense formula has four nonzero values\>\"", ",", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"And", "@@", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"#1", "\[NotEqual]", "0"}], "&"}], ")"}], "/@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"b", ",", "c", ",", "d", ",", "f"}], "}"}], "/.", 
          "\[VeryThinSpace]", "denseRules"}], ")"}]}]}], ",", 
      "denseAssumptions"}], "]"}], ",", "True"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"denseTuple", "[", 
    RowBox[{"bb_", ",", "dd_"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{"bb", ",", 
     FractionBox[
      RowBox[{"2", " ", 
       SuperscriptBox["bb", "3"]}], 
      SuperscriptBox["dd", "2"]], ",", "dd", ",", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"4", " ", 
        SuperscriptBox["bb", "4"]}], 
       SuperscriptBox["dd", "3"]]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"MatrixForm", "[", "denseMatrix", "]"}]}], "Input",
 InitializationCell->False,
 CellLabel->
  "In[369]:=",ExpressionUUID->"7fd86458-1214-ae4c-8778-dfdd92f683e6"],

Cell[BoxData[
 TagBox[RowBox[{"(", "\:2060", GridBox[{{"0", "b", "d"}, {FractionBox[RowBox[{"2", " ", SuperscriptBox["b", "3"]}], SuperscriptBox["d", "2"]], "0", "b"}, {RowBox[{"-", FractionBox[RowBox[{"4", " ", SuperscriptBox["b", "4"]}], SuperscriptBox["d", "3"]]}], FractionBox[RowBox[{"2", " ", SuperscriptBox["b", "3"]}], SuperscriptBox["d", "2"]], "0"}}, RowSpacings -> 1, ColumnSpacings -> 1, RowAlignments -> Baseline, ColumnAlignments -> Center], "\:2060", ")"}], Function[BoxForm`e$, MatrixForm[BoxForm`e$]]]], "Output",
 CellChangeTimes->{{4.000439711145439*^9, 4.000439754379513*^9}, 
   4.0004399626499596`*^9, {4.0004400183294296`*^9, 4.000440042215439*^9}},
 CellLabel->
  "Out[378]=",ExpressionUUID->"72e9d825-fcfb-3c4b-923d-3e7d0f834d1f"]
}, Open  ]],

Cell["\<\
Two freely chosen values remain: b and d. This is a complete description over \
the real numbers. Choosing rational b,d gives rational matrices; choosing \
integers need not give integer c,f. \
\>", "Text",
 CellChangeTimes->{
  4.0004383601257286`*^9},ExpressionUUID->"b3901e05-7ae0-364a-8b2c-\
9421d19a6667"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Classify all 16 nonzero sign arrangements", "Section",ExpressionUUID->"66076486-1fab-c94a-8b1d-39d44bba26b6"],

Cell["\<\
Because d^2 is positive, c d^2 = 2b^3 forces c and b to have the same sign. \
Because b^4 is positive, f = -4b^4/d^3 forces f and d to have opposite signs. \
These restrictions are also sufficient: each allowed sign arrangement has an \
explicit nilpotent witness.\
\>", "Text",ExpressionUUID->"25d33041-7406-6b47-bd87-9681fb387872"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    TemplateBox[{"b"},
     "Sign"], "\[LongEqual]", 
    TemplateBox[{"c"},
     "Sign"]}],
   HoldForm], TraditionalForm]], "DisplayFormula",ExpressionUUID->"8efdca7f-\
63cb-0a44-b0f4-f5daa77cf535"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    TemplateBox[{"d"},
     "Sign"], "\[LongEqual]", 
    RowBox[{"-", 
     TemplateBox[{"f"},
      "Sign"]}]}],
   HoldForm], TraditionalForm]], "DisplayFormula",ExpressionUUID->"4d03fc91-\
5727-a04d-a518-6507dd12023d"],

Cell["\<\
In all sign strings and tables, the order is (b,c,d,f). Thus ++-- means b,c \
positive and d,f negative\
\>", "Text",
 CellChangeTimes->{
  4.000438460388214*^9},ExpressionUUID->"a70cf94d-8b2e-ce45-b013-\
c2bc5ef2cd77"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"denseSignTuples", "=", 
   RowBox[{"Tuples", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "4"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"denseSignRows", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"possible", ",", "rule", ",", "witness"}], "}"}], ",", 
       RowBox[{
        RowBox[{"possible", "=", 
         RowBox[{"Resolve", "[", 
          RowBox[{
           RowBox[{
            SubscriptBox["\[Exists]", 
             RowBox[{"{", 
              RowBox[{"b", ",", "c", ",", "d", ",", "f"}], "}"}]], 
            RowBox[{"(", 
             RowBox[{"nilConditions", "&&", 
              RowBox[{"signConditions", "[", "s", "]"}]}], ")"}]}], ",", 
           TemplateBox[{},
            "Reals"]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"rule", "=", 
         RowBox[{
          RowBox[{
           RowBox[{
           "s", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "\[Equal]", 
           RowBox[{
           "s", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], "&&", 
          RowBox[{
           RowBox[{
           "s", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], "\[Equal]", 
           RowBox[{"-", 
            RowBox[{
            "s", "\[LeftDoubleBracket]", "4", 
             "\[RightDoubleBracket]"}]}]}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"witness", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"TrueQ", "[", "possible", "]"}], ",", 
           RowBox[{"denseTuple", "[", 
            RowBox[{
             RowBox[{
             "s", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
             RowBox[{
             "s", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}]}], 
            "]"}], ",", "\"\<none\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Association", "[", 
         RowBox[{
          RowBox[{"\"\<Signs (b,c,d,f)\>\"", "\[Rule]", 
           RowBox[{"signText", "[", "s", "]"}]}], ",", 
          RowBox[{"\"\<Admits nilpotency\>\"", "\[Rule]", "possible"}], ",", 
          RowBox[{"\"\<Simple sign rule\>\"", "\[Rule]", "rule"}], ",", 
          RowBox[{"\"\<Witness tuple\>\"", "\[Rule]", "witness"}]}], 
         "]"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"s", ",", "denseSignTuples"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"recordCheck", "[", 
   RowBox[{"\"\<All 16 sign decisions agree with the rule\>\"", ",", 
    RowBox[{"And", "@@", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"#1", "[", "\"\<Admits nilpotency\>\"", "]"}], "===", 
         RowBox[{"#1", "[", "\"\<Simple sign rule\>\"", "]"}]}], "&"}], ")"}],
       "/@", "denseSignRows"}]}], ",", "True"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"recordCheck", "[", 
   RowBox[{"\"\<Exactly four dense sign arrangements admit nilpotency\>\"", ",", 
    RowBox[{"Count", "[", 
     RowBox[{
      RowBox[{"Lookup", "[", 
       RowBox[{"denseSignRows", ",", "\"\<Admits nilpotency\>\""}], "]"}], ",",
       "True"}], "]"}], ",", "4"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"recordCheck", "[", 
   RowBox[{"\"\<All four dense sign witnesses have zero cube\>\"", ",", 
    RowBox[{"And", "@@", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"zeroMatrixQ", "[", 
         RowBox[{"MatrixPower", "[", 
          RowBox[{
           RowBox[{"mat", "[", 
            RowBox[{"#1", "[", "\"\<Witness tuple\>\"", "]"}], "]"}], ",", 
           "3"}], "]"}], "]"}], "&"}], ")"}], "/@", 
      RowBox[{"Select", "[", 
       RowBox[{"denseSignRows", ",", 
        RowBox[{
         RowBox[{"TrueQ", "[", 
          RowBox[{"#1", "[", "\"\<Admits nilpotency\>\"", "]"}], "]"}], 
         "&"}]}], "]"}]}]}], ",", "True"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Prepend", "[", 
     RowBox[{
      RowBox[{"Values", "/@", "denseSignRows"}], ",", 
      RowBox[{"Keys", "[", 
       RowBox[{"First", "[", "denseSignRows", "]"}], "]"}]}], "]"}], 
    "\[LeftDoubleBracket]", 
    RowBox[{"All", ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "4"}], "}"}]}], 
    "\[RightDoubleBracket]"}], ",", 
   RowBox[{"Frame", "\[Rule]", "All"}], ",", 
   RowBox[{"Alignment", "\[Rule]", "Left"}]}], "]"}]}], "Input",
 InitializationCell->False,
 CellLabel->
  "In[379]:=",ExpressionUUID->"f2bc953a-17a4-9640-aa3b-d494d74bb043"],

