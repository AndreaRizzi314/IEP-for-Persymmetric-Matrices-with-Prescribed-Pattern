Cell[CellGroupData[{

Cell["2. Multiply the matrix before using the theorem", "Section",ExpressionUUID->"47255f93-579b-2649-84f6-0074f367af24"],

Cell["\<\
For a 3 by 3 matrix, nilpotency is equivalent to A^3 = 0. The (1,1) entry of \
A^2 is 0*0 + b*c + d*f = bc + df, and its (1,3) entry is 0*d + b*b + d*0 = \
b^2.\
\>", "Text",
 CellChangeTimes->{
  4.000375816124794*^9, {4.00037586862492*^9, 
   4.0003758724176903`*^9}},ExpressionUUID->"2f69855e-4fa3-4243-a294-\
d50800773259"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"aSquare", "=", 
   RowBox[{"Expand", "[", 
    RowBox[{"MatrixPower", "[", 
     RowBox[{"aMatrix", ",", "2"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"aCube", "=", 
   RowBox[{"Expand", "[", 
    RowBox[{"MatrixPower", "[", 
     RowBox[{"aMatrix", ",", "3"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p2", "=", 
   RowBox[{
    RowBox[{"2", " ", "b", " ", "c"}], "+", 
    RowBox[{"d", " ", "f"}]}]}], ";"}], "\[IndentingNewLine]", 
