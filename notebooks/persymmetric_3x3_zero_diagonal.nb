      RowBox[{"p2", " ", "aMatrix"}], "-", 
      RowBox[{"q3", " ", 
       RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], "]"}], ",", "zero3"}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 TagBox[GridBox[{
    {"\"\<A^2\>\"", 
     RowBox[{"MatrixForm", "[", "aSquare", "]"}]},
    {"\"\<A^3\>\"", 
     RowBox[{"MatrixForm", "[", "aCube", "]"}]}
