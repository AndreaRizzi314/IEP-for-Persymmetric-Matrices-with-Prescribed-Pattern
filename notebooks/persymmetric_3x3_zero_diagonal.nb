Cell[CellGroupData[{

Cell["6. Worked examples: cancellation and its failure", "Section",ExpressionUUID->"138c4db4-e572-c44e-a724-d32f420b9958"],

Cell["\<\
Start with b=1,c=2,d=1,f=-4. The first cancellation is 2*(1)*(2) + (1)*(-4) = \
4-4 = 0. The second is (1)^2*(-4) + (2)^2*(1) = -4+4 = 0. The following cell \
displays the matrix, its square and its cube separately.\
\>", "Text",ExpressionUUID->"6b31bf2b-739c-5f40-8d85-b38092539153"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"canonicalN", "=", 
   RowBox[{"mat", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "1", ",", 
      RowBox[{"-", "4"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"recordCheck", "[", 
   RowBox[{"\"\<Canonical example square\>\"", ",", 
    RowBox[{"MatrixPower", "[", 
     RowBox[{"canonicalN", ",", "2"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "2"}], ",", "2", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "4"}], ",", "4", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"4", ",", 
        RowBox[{"-", "4"}], ",", 
        RowBox[{"-", "2"}]}], "}"}]}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"recordCheck", "[", 
   RowBox[{"\"\<Canonical example has nonzero square\>\"", ",", 
    RowBox[{"zeroMatrixQ", "[", 
     RowBox[{"MatrixPower", "[", 
      RowBox[{"canonicalN", ",", "2"}], "]"}], "]"}], ",", "False"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"recordCheck", "[", 
   RowBox[{"\"\<Canonical example has zero cube\>\"", ",", 
    RowBox[{"MatrixPower", "[", 
     RowBox[{"canonicalN", ",", "3"}], "]"}], ",", "zero3"}], "]"}], ";"}], "\[IndentingNewLine]", 
 TagBox[GridBox[{
    {"\"\<N\>\"", 
     RowBox[{"MatrixForm", "[", "canonicalN", "]"}]},
    {"\"\<N^2\>\"", 
     RowBox[{"MatrixForm", "[", RowBox[{"MatrixPower", "[", 
       RowBox[{"canonicalN", ",", "2"}], "]"}], "]"}]},
    {"\"\<N^3\>\"", 
     RowBox[{"MatrixForm", "[", RowBox[{"MatrixPower", "[", 
       RowBox[{"canonicalN", ",", "3"}], "]"}], "]"}]},
    {"\"\<Characteristic polynomial\>\"", 
     RowBox[{"monicChar", "[", 
      RowBox[{"canonicalN", ",", "x"}], "]"}]}
   },
   AutoDelete->False,
