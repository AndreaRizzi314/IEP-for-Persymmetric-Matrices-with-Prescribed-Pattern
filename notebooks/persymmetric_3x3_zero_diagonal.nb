Cell["\<\
Every diagonal entry of A^3 is q. Every off-diagonal entry is the \
corresponding entry of A multiplied by p. Thus A^3 = 0 forces q = 0; if A is \
nonzero it also forces p = 0. For A = 0, both p and q already vanish. \
Therefore the two scalar conditions below are necessary AND sufficient, \
including cases where entries are zero.\
\>", "Text",ExpressionUUID->"308e6c19-b3c6-b64c-ab3d-6dee89b070b5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nilConditions", "=", 
   RowBox[{
    RowBox[{"p2", "\[Equal]", "0"}], "&&", 
    RowBox[{"q3", "\[Equal]", "0"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cubeZeroConditions", "=", 
   RowBox[{"And", "@@", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"#1", "\[Equal]", "0"}], "&"}], ")"}], "/@", 
     RowBox[{"Flatten", "[", "aCube", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cubeEquivalence", "=", 
   RowBox[{"Resolve", "[", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[ForAll]", 
       RowBox[{"{", 
        RowBox[{"b", ",", "c", ",", "d", ",", "f"}], "}"}]], 
      RowBox[{"(", 
       RowBox[{"cubeZeroConditions", "\[Equivalent]", "nilConditions"}], 
       ")"}]}], ",", 
     TemplateBox[{},
      "Reals"]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"recordCheck", "[", 
   RowBox[{"\"\<Cube zero iff both scalar equations vanish\>\"", ",", 
    "cubeEquivalence", ",", "True"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{"nilConditions", ",", "cubeEquivalence"}], "}"}]}], "Input",
 InitializationCell->False,
 CellLabel->
  "In[350]:=",ExpressionUUID->"7d86ff14-5b97-0e49-8994-5ca7cb07fccc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"2", " ", "b", " ", "c"}], "+", 
      RowBox[{"d", " ", "f"}]}], "\[Equal]", "0"}], "&&", 
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox["c", "2"], " ", "d"}], "+", 
      RowBox[{
       SuperscriptBox["b", "2"], " ", "f"}]}], "\[Equal]", "0"}]}], ",", 
   "True"}], "}"}]], "Output",
 CellChangeTimes->{{4.00043971109544*^9, 4.000439754330515*^9}, 
   4.0004399617228584`*^9, {4.00044001827643*^9, 4.0004400421794376`*^9}},
 CellLabel->
  "Out[354]=",ExpressionUUID->"1822670a-f06c-3344-9e64-92b316a17464"]
