 TagBox[GridBox[{
    {"\<\"Perturbed matrix\"\>", 
     TagBox[RowBox[{"(", "\:2060", GridBox[{{"0", "1", "1"}, {"2", "0", "1"}, {RowBox[{"-", "3"}], "2", "0"}}, RowSpacings -> 1, ColumnSpacings -> 1, RowAlignments -> Baseline, ColumnAlignments -> Center], "\:2060", ")"}], Function[BoxForm`e$, MatrixForm[BoxForm`e$]]]},
    {"\<\"Its cube\"\>", 
