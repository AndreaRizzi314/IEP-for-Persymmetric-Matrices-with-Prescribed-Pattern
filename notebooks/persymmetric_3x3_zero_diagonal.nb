Cell[CellGroupData[{

Cell["\<\
7. Rank, nilpotency index, minimal polynomial and Jordan form\
\>", "Section",ExpressionUUID->"1f8dd62d-bd9f-e047-9398-7a2dc3caae75"],

Cell["\<\
Every all-nonzero nilpotent matrix in this family has index THREE. The (1,3) \
entry of A^2 is b^2, so A^2 cannot be zero when b is nonzero. We already \
proved A^3=0. The minor in rows 1,2 and columns 2,3 is b^2, so rank(A) is at \
least two; det(A)=0 makes its rank exactly two. Its square has rank one.\
\>", "Text",ExpressionUUID->"9ba1d139-3e8a-9c45-81b6-be8b2a3b868e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"denseSquare", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"MatrixPower", "[", 
      RowBox[{"denseMatrix", ",", "2"}], "]"}], ",", "denseAssumptions"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rankMinor", "=", 
   RowBox[{"Det", "[", 
    RowBox[{"aMatrix", "\[LeftDoubleBracket]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "3"}], "}"}]}], "\[RightDoubleBracket]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"recordCheck", "[", 
   RowBox[{"\"\<Rank-two minor\>\"", ",", "rankMinor", ",", 
    SuperscriptBox["b", "2"]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"recordCheck", "[", 
   RowBox[{"\"\<Square is nonzero in dense case\>\"", ",", 
    RowBox[{"denseSquare", "\[LeftDoubleBracket]", 
     RowBox[{"1", ",", "3"}], "\[RightDoubleBracket]"}], ",", 
    SuperscriptBox["b", "2"]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"recordCheck", "[", 
   RowBox[{"\"\<Dense matrix generic exact rank\>\"", ",", 
    RowBox[{"MatrixRank", "[", "denseMatrix", "]"}], ",", "2"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"recordCheck", "[", 
   RowBox[{"\"\<Dense square generic exact rank\>\"", ",", 
    RowBox[{"MatrixRank", "[", "denseSquare", "]"}], ",", "1"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 TagBox[GridBox[{
    {"\"\<Minor proving rank at least 2\>\"", "rankMinor"},
    {"\"\<A^2 (1,3) entry\>\"", 
     RowBox[{"denseSquare", "\[LeftDoubleBracket]", 
      RowBox[{"1", ",", "3"}], "\[RightDoubleBracket]"}]},
    {"\"\<Rank(A)\>\"", 
     RowBox[{"MatrixRank", "[", "denseMatrix", "]"}]},
    {"\"\<Rank(A^2)\>\"", 
     RowBox[{"MatrixRank", "[", "denseSquare", "]"}]},
    {"\"\<Minimal polynomial\>\"", 
     SuperscriptBox["x", "3"]}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]}], "Input",
 InitializationCell->False,
 CellLabel->
  "In[398]:=",ExpressionUUID->"48e99226-2e9b-074b-b6fb-db102346d7eb"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"Minor proving rank at least 2\"\>", 
     SuperscriptBox["b", "2"]},
    {"\<\"A^2 (1,3) entry\"\>", 
     SuperscriptBox["b", "2"]},
    {"\<\"Rank(A)\"\>", "2"},
    {"\<\"Rank(A^2)\"\>", "1"},
    {"\<\"Minimal polynomial\"\>", 
     SuperscriptBox["x", "3"]}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",
 CellChangeTimes->{{4.000439711284954*^9, 4.0004397544790306`*^9}, 
   4.000439962796467*^9, {4.0004400184639015`*^9, 4.000440042316946*^9}},
 CellLabel->
  "Out[404]=",ExpressionUUID->"404d0d68-71b0-a44b-ba63-fe9d7d0aa7b1"]
}, Open  ]],

Cell["\<\
The minimal polynomial is x^3: x^3 annihilates A, but x and x^2 do not. A \
nonzero nilpotent matrix cannot be diagonalizable, because a diagonal matrix \
whose eigenvalues are all zero is itself zero. Here there is a single Jordan \
block of size three.\
\>", "Text",ExpressionUUID->"2d17f8c9-b30f-8e4c-ac08-ce9ec8b7c038"],

Cell["\<\
A concrete Jordan basis avoids treating Jordan form as a black box. Let \
u=(0,0,1)^T. The three columns A^2u, Au, u form a basis: their determinant is \
-b^3. In that basis A sends the first column to 0, the second to the first, \
and the third to the second.\
\>", "Text",ExpressionUUID->"c46e4fbf-94ab-2344-bd69-578667928f6e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"unit3", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"jordanBasis", "=", 
   TemplateBox[{
     RowBox[{"{", 
       RowBox[{
         RowBox[{"denseSquare", ".", "unit3"}], ",", 
         RowBox[{"denseMatrix", ".", "unit3"}], ",", "unit3"}], "}"}]},
    "Transpose"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"upperShift", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"recordCheck", "[", 
   RowBox[{"\"\<Jordan basis determinant\>\"", ",", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"Det", "[", "jordanBasis", "]"}], ",", "denseAssumptions"}], 
     "]"}], ",", 
    RowBox[{"-", 
     SuperscriptBox["b", "3"]}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"recordCheck", "[", 
   RowBox[{"\"\<Explicit Jordan-chain identity\>\"", ",", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"denseMatrix", ".", "jordanBasis"}], "-", 
       RowBox[{"jordanBasis", ".", "upperShift"}]}], ",", 
      "denseAssumptions"}], "]"}], ",", "zero3"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"recordCheck", "[", 
   RowBox[{"\"\<Similarity to the upper shift\>\"", ",", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{
       TemplateBox[{"jordanBasis"},
        "Inverse"], ".", "denseMatrix", ".", "jordanBasis"}], ",", 
      "denseAssumptions"}], "]"}], ",", "upperShift"}], "]"}], ";"}], "\[IndentingNewLine]", 
 TagBox[GridBox[{
    {"\"\<Basis matrix P\>\"", 
     RowBox[{"MatrixForm", "[", "jordanBasis", "]"}]},
    {"\"\<det(P)\>\"", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"Det", "[", "jordanBasis", "]"}], ",", "denseAssumptions"}], 
      "]"}]},
    {"\"\<P^-1 A P\>\"", 
     RowBox[{"MatrixForm", "[", "upperShift", "]"}]}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
   GridBoxSpacings->{"Columns" -> {{2}}, "Rows" -> {{1}}}],
  "Grid"]}], "Input",
 InitializationCell->False,
 CellLabel->
  "In[405]:=",ExpressionUUID->"e3bb5d60-61ca-eb45-b430-e9270e883190"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"Basis matrix P\"\>", 
     TagBox[RowBox[{"(", "\:2060", GridBox[{{SuperscriptBox["b", "2"], "d", "0"}, {FractionBox[RowBox[{"2", " ", SuperscriptBox["b", "3"]}], "d"], "b", "0"}, {RowBox[{"-", FractionBox[RowBox[{"2", " ", SuperscriptBox["b", "4"]}], SuperscriptBox["d", "2"]]}], "0", "1"}}, RowSpacings -> 1, ColumnSpacings -> 1, RowAlignments -> Baseline, ColumnAlignments -> Center], "\:2060", ")"}], Function[BoxForm`e$, MatrixForm[BoxForm`e$]]]},
    {"\<\"det(P)\"\>", 
     RowBox[{"-", 
      SuperscriptBox["b", "3"]}]},
    {"\<\"P^-1 A P\"\>", 
     TagBox[RowBox[{"(", "\:2060", GridBox[{{"0", "1", "0"}, {"0", "0", "1"}, {"0", "0", "0"}}, RowSpacings -> 1, ColumnSpacings -> 1, RowAlignments -> Baseline, ColumnAlignments -> Center], "\:2060", ")"}], Function[BoxForm`e$, MatrixForm[BoxForm`e$]]]}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
   GridBoxSpacings->{"Columns" -> {{2}}, "Rows" -> {{1}}}],
  "Grid"]], "Output",
 CellChangeTimes->{{4.000439711293461*^9, 4.000439754500536*^9}, 
   4.0004399628214684`*^9, {4.0004400184709015`*^9, 4.0004400423419495`*^9}},
 CellLabel->
  "Out[411]=",ExpressionUUID->"54f2932f-b141-0a48-bafa-6297b6337641"]
}, Open  ]]
