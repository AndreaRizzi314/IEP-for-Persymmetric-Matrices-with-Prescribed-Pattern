       RowBox[{"c", " ", "d"}], ",", 
       SuperscriptBox["b", "2"]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"b", " ", "f"}], ",", 
       RowBox[{"2", " ", "b", " ", "c"}], ",", 
       RowBox[{"c", " ", "d"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       SuperscriptBox["c", "2"], ",", 
       RowBox[{"b", " ", "f"}], ",", 
       RowBox[{
        RowBox[{"b", " ", "c"}], "+", 
        RowBox[{"d", " ", "f"}]}]}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
