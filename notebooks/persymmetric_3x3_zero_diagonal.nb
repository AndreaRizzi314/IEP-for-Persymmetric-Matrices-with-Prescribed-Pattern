Cell["\<\
The four admissible strings are +++-, ++-+, --+-, and ---+. There is no \
relationship between the sign of b and the sign of d. These are EXISTENCE \
statements. Suitable signs do not make arbitrary magnitudes nilpotent.\
\>", "Text",ExpressionUUID->"f5a42b53-48da-0f4b-9fc3-0e5597ead075"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"fourWitnesses", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"mat", "[", 
        RowBox[{"{", 
         RowBox[{"s", ",", 
          RowBox[{"2", " ", "s"}], ",", "t", ",", 
          RowBox[{
           RowBox[{"-", "4"}], " ", "t"}]}], "}"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"s", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}], "]"}], ",", 
     "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
