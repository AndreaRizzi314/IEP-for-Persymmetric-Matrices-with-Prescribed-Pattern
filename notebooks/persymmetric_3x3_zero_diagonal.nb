Cell["\<\
Now change only f from -4 to -3. The zero positions, persymmetry and every \
entry sign are preserved. However, both cancellation totals become 1. Its \
characteristic polynomial is x^3-x-1 and its cube is A+I, not zero. This \
proves that the dense 0/* pattern does not force nilpotency.\
\>", "Text",ExpressionUUID->"f8398587-f40d-af4d-83de-986ff42e452b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"perturbedN", "=", 
   RowBox[{"mat", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "1", ",", 
      RowBox[{"-", "3"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"recordCheck", "[", 
   RowBox[{"\"\<Perturbation preserves signs\>\"", ",", 
    RowBox[{"Sign", "[", "perturbedN", "]"}], ",", 
    RowBox[{"Sign", "[", "canonicalN", "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"recordCheck", "[", 
   RowBox[{"\"\<Perturbation polynomial\>\"", ",", 
    RowBox[{"Expand", "[", 
     RowBox[{"monicChar", "[", 
      RowBox[{"perturbedN", ",", "x"}], "]"}], "]"}], ",", 
    RowBox[{
     SuperscriptBox["x", "3"], "-", "x", "-", "1"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"recordCheck", "[", 
   RowBox[{"\"\<Perturbation cube\>\"", ",", 
    RowBox[{"MatrixPower", "[", 
     RowBox[{"perturbedN", ",", "3"}], "]"}], ",", 
    RowBox[{"perturbedN", "+", 
     RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 TagBox[GridBox[{
    {"\"\<Perturbed matrix\>\"", 
     RowBox[{"MatrixForm", "[", "perturbedN", "]"}]},
    {"\"\<Its cube\>\"", 
     RowBox[{"MatrixForm", "[", RowBox[{"MatrixPower", "[", 
       RowBox[{"perturbedN", ",", "3"}], "]"}], "]"}]},
    {"\"\<Its characteristic polynomial\>\"", 
     RowBox[{"monicChar", "[", 
      RowBox[{"perturbedN", ",", "x"}], "]"}]}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
