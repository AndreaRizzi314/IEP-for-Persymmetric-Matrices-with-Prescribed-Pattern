Cell[CellGroupData[{

Cell["8. All dense solutions share one canonical construction", "Section",ExpressionUUID->"28e33cf5-08fb-6e45-b058-db12330619a2"],

Cell["\<\
The two-parameter formula has another interpretation. Start with N from \
section 6, multiply it by a nonzero scalar k, and apply diagonal similarity \
using D=diag(r,1,1/r), where r is nonzero. This preserves nilpotency. The \
special form of D also preserves persymmetry.\
\>", "Text",ExpressionUUID->"3ad29f9c-6fd3-284e-9ae6-5001f517e418"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{"D", "\[LongEqual]", 
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{"{", 
      RowBox[{"r", ",", "1", ",", 
       FractionBox["1", "r"]}], "}"}], "]"}]}],
   HoldForm], TraditionalForm]], "DisplayFormula",ExpressionUUID->"5a989ee8-\
b02b-d345-8ce7-f08112a0d000"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{"A", "\[LongEqual]", 
    RowBox[{"k", " ", 
     RowBox[{"D", ".", "N", ".", 
      TemplateBox[{"D"},
       "Inverse"]}]}]}],
   HoldForm], TraditionalForm]], "DisplayFormula",ExpressionUUID->"d69fbebc-\
22d9-ef4f-bb1b-13c282d55a59"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"diagonalD", "=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{"r", ",", "1", ",", 
      FractionBox["1", "r"]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"scaledCanonical", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"k", " ", 
      RowBox[{"diagonalD", ".", "canonicalN", ".", 
       TemplateBox[{"diagonalD"},
        "Inverse"]}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"k", ",", "r"}], "}"}], "\[Element]", 
       TemplateBox[{},
        "Reals"]}], "&&", 
      RowBox[{"k", "\[NotEqual]", "0"}], "&&", 
      RowBox[{"r", "\[NotEqual]", "0"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"recordCheck", "[", 
   RowBox[{"\"\<D preserves reversal form\>\"", ",", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{
       TemplateBox[{"diagonalD"},
        "Transpose"], ".", "j3", ".", "diagonalD"}], ",", 
      RowBox[{"r", "\[NotEqual]", "0"}]}], "]"}], ",", "j3"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"recordCheck", "[", 
   RowBox[{"\"\<Scaled construction is persymmetric\>\"", ",", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"scaledCanonical", "-", 
       RowBox[{"j3", ".", 
        TemplateBox[{"scaledCanonical"},
         "Transpose"], ".", "j3"}]}], ",", 
      RowBox[{"r", "\[NotEqual]", "0"}]}], "]"}], ",", "zero3"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"recordCheck", "[", 
   RowBox[{"\"\<Scaled construction recovers every dense solution\>\"", ",", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"scaledCanonical", "/.", "\[VeryThinSpace]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"k", "\[Rule]", 
            FractionBox[
             SuperscriptBox["b", "2"], "d"]}], ",", 
           RowBox[{"r", "\[Rule]", 
            FractionBox["d", "b"]}]}], "}"}]}], ")"}], "-", "denseMatrix"}], ",",
       "denseAssumptions"}], "]"}], ",", "zero3"}], "]"}], ";"}], "\[IndentingNewLine]", 
 TagBox[GridBox[{
    {"\"\<k D N D^-1\>\"", 
     RowBox[{"MatrixForm", "[", "scaledCanonical", "]"}]},
    {"\"\<Choose k\>\"", 
     FractionBox[
      SuperscriptBox["b", "2"], "d"]},
    {"\"\<Choose r\>\"", 
     FractionBox["d", "b"]}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
   GridBoxSpacings->{"Columns" -> {{2}}, "Rows" -> {{1}}}],
  "Grid"]}], "Input",
 InitializationCell->False,
 CellLabel->
  "In[412]:=",ExpressionUUID->"7d578b0b-629c-0542-9cf7-f2f175fd8d45"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"k D N D^-1\"\>", 
     TagBox[RowBox[{"(", "\:2060", GridBox[{{"0", RowBox[{"k", " ", "r"}], RowBox[{"k", " ", SuperscriptBox["r", "2"]}]}, {FractionBox[RowBox[{"2", " ", "k"}], "r"], "0", RowBox[{"k", " ", "r"}]}, {RowBox[{"-", FractionBox[RowBox[{"4", " ", "k"}], SuperscriptBox["r", "2"]]}], FractionBox[RowBox[{"2", " ", "k"}], "r"], "0"}}, RowSpacings -> 1, ColumnSpacings -> 1, RowAlignments -> Baseline, ColumnAlignments -> Center], "\:2060", ")"}], Function[BoxForm`e$, MatrixForm[BoxForm`e$]]]},
    {"\<\"Choose k\"\>", 
     FractionBox[
      SuperscriptBox["b", "2"], "d"]},
    {"\<\"Choose r\"\>", 
     FractionBox["d", "b"]}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
   GridBoxSpacings->{"Columns" -> {{2}}, "Rows" -> {{1}}}],
  "Grid"]], "Output",
 CellChangeTimes->{{4.0004397113204613`*^9, 4.000439754524536*^9}, 
   4.0004399628499756`*^9, {4.0004400184949017`*^9, 4.0004400423644543`*^9}},
 CellLabel->
  "Out[417]=",ExpressionUUID->"289d11f9-34a5-464f-a4f2-37e2b482337f"]
}, Open  ]],

Cell["\<\
Thus every dense nilpotent solution is obtained from one N by scaling and \
this special diagonal similarity. Arbitrary diagonal similarities need not \
preserve persymmetry, so the form of D matters. A positive or negative r and \
k produce the four admissible sign arrangements. These equivalences are also \
a warning for ML: many apparently different examples may be transformed \
versions of the same construction.\
\>", "Text",ExpressionUUID->"efb6339a-c417-6849-8ff9-38dbf3968f29"]
}, Open  ]],

Cell[CellGroupData[{

Cell["9. The graph explains which products cancel", "Section",ExpressionUUID->"92aeffc4-e60f-0246-bdbd-0722e882020b"],

Cell["\<\
Interpret a nonzero entry a_ij as a directed edge i -> j weighted by a_ij. In \
the dense case all six directed off-diagonal edges exist. A matrix power sums \
the products of edge weights along walks. Positive and negative products can \
therefore cancel even though the graph contains cycles.\
\>", "Text",ExpressionUUID->"6d653ecd-90ac-4d40-a90c-f907c530086c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"cycleRows", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<1 -> 2 -> 1\>\"", ",", 
       RowBox[{"b", " ", "c"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<2 -> 3 -> 2\>\"", ",", 
       RowBox[{"b", " ", "c"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<1 -> 3 -> 1\>\"", ",", 
       RowBox[{"d", " ", "f"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<1 -> 2 -> 3 -> 1\>\"", ",", 
       RowBox[{
        SuperscriptBox["b", "2"], " ", "f"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<1 -> 3 -> 2 -> 1\>\"", ",", 
       RowBox[{
        SuperscriptBox["c", "2"], " ", "d"}]}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{"cycleRows", ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Directed cycle\>\"", ",", "\"\<Weight product\>\""}], 
      "}"}]}], "]"}], ",", 
   RowBox[{"Frame", "\[Rule]", "All"}], ",", 
   RowBox[{"Alignment", "\[Rule]", "Left"}]}], "]"}]}], "Input",
 InitializationCell->False,
 CellLabel->
  "In[418]:=",ExpressionUUID->"f489e69c-afa3-b144-85d1-85d8369e111d"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"Directed cycle\"\>", "\<\"Weight product\"\>"},
    {"\<\"1 -> 2 -> 1\"\>", 
     RowBox[{"b", " ", "c"}]},
    {"\<\"2 -> 3 -> 2\"\>", 
     RowBox[{"b", " ", "c"}]},
    {"\<\"1 -> 3 -> 1\"\>", 
     RowBox[{"d", " ", "f"}]},
    {"\<\"1 -> 2 -> 3 -> 1\"\>", 
     RowBox[{
      SuperscriptBox["b", "2"], " ", "f"}]},
    {"\<\"1 -> 3 -> 2 -> 1\"\>", 
     RowBox[{
      SuperscriptBox["c", "2"], " ", "d"}]}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",
 CellChangeTimes->{{4.000439711338461*^9, 4.0004397545295353`*^9}, 
   4.0004399628739758`*^9, {4.000440018514902*^9, 4.0004400423834553`*^9}},
 CellLabel->
  "Out[419]=",ExpressionUUID->"0da9c913-baae-9b4d-9acb-496846584d14"]
}, Open  ]],

Cell["\<\
The three directed 2-cycles have total weight 2bc+df. The two directed \
3-cycles, counted once each up to cyclic rotation, have total weight \
b^2f+c^2d. Dense nilpotency means both totals cancel. The two bc products are \
positive, the df product is negative, and df=-2bc. The two 3-cycle products \
have opposite signs and equal magnitudes.\
\>", "Text",ExpressionUUID->"6f59c78b-4475-704c-ae45-79f496adfedc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ratioAssumptions", "=", 
   RowBox[{"nonzeroAssumptions", "&&", "nilConditions"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"recordCheck", "[", 
   RowBox[{"\"\<Two-cycle cancellation ratio\>\"", ",", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{"d", " ", "f"}], 
        RowBox[{"b", " ", "c"}]], "/.", "\[VeryThinSpace]", "denseRules"}], ",",
       "denseAssumptions"}], "]"}], ",", 
    RowBox[{"-", "2"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"recordCheck", "[", 
   RowBox[{"\"\<Three-cycle cancellation ratio\>\"", ",", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{
         SuperscriptBox["b", "2"], " ", "f"}], 
        RowBox[{
         SuperscriptBox["c", "2"], " ", "d"}]], "/.", "\[VeryThinSpace]", 
       "denseRules"}], ",", "denseAssumptions"}], "]"}], ",", 
    RowBox[{"-", "1"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{"d", " ", "f"}], 
       RowBox[{"b", " ", "c"}]], "/.", "\[VeryThinSpace]", "denseRules"}], ",",
      "denseAssumptions"}], "]"}], ",", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{
        SuperscriptBox["b", "2"], " ", "f"}], 
       RowBox[{
        SuperscriptBox["c", "2"], " ", "d"}]], "/.", "\[VeryThinSpace]", 
      "denseRules"}], ",", "denseAssumptions"}], "]"}]}], "}"}]}], "Input",
 InitializationCell->False,
 CellLabel->
  "In[420]:=",ExpressionUUID->"fb5441ea-9a85-aa45-affd-2823715479a4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "2"}], ",", 
   RowBox[{"-", "1"}]}], "}"}]], "Output",
 CellChangeTimes->{{4.0004397113424625`*^9, 4.0004397545495358`*^9}, 
   4.000439962895977*^9, {4.000440018518902*^9, 4.000440042387457*^9}},
 CellLabel->
  "Out[423]=",ExpressionUUID->"1c912464-08d9-af47-a7e8-989b3063f85d"]
}, Open  ]],

Cell["\<\
No dense entrywise nonnegative or nonpositive matrix is nilpotent: bc and df \
would both be positive. No nonzero real symmetric matrix in this \
zero-diagonal family is nilpotent either. Symmetry would require c=b and f=d, \
reducing the first equation to 2b^2+d^2=0, which forces b=d=0.\
\>", "Text",ExpressionUUID->"73d272d5-6c40-4644-bf2d-cca8ec8c3862"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"symmetricConditions", "=", 
   RowBox[{"nilConditions", "&&", 
    RowBox[{"c", "\[Equal]", "b"}], "&&", 
    RowBox[{"f", "\[Equal]", "d"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"symmetricNilSolution", "=", 
   RowBox[{"Reduce", "[", 
    RowBox[{"symmetricConditions", ",", "vars", ",", 
     TemplateBox[{},
      "Reals"]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"recordCheck", "[", 
   RowBox[{"\"\<Only symmetric nilpotent solution is zero\>\"", ",", 
    RowBox[{"Resolve", "[", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[ForAll]", 
        RowBox[{"{", 
         RowBox[{"b", ",", "c", ",", "d", ",", "f"}], "}"}]], 
       RowBox[{"(", 
        RowBox[{"symmetricConditions", "\[Equivalent]", 
         RowBox[{
          RowBox[{"b", "\[Equal]", "0"}], "&&", 
