                          {"2", " ", "b", " ", "c", " ", "d"}], "+", RowBox[
                          {SuperscriptBox["d", "2"], " ", "f"}]}]}, 
                      {RowBox[{RowBox[{"3", " ", SuperscriptBox["a", "2"], 
                          " ", "c"}], "+", RowBox[{"2", " ", "b", " ", 
                          SuperscriptBox["c", "2"]}], "+", RowBox[{"c", " ", 
                          "d", " ", "f"}]}], RowBox[{RowBox[{RowBox[{"-", 
                          "8"}], " ", SuperscriptBox["a", "3"]}], "-", 
                         RowBox[{"6", " ", "a", " ", "b", " ", "c"}], "+", 
