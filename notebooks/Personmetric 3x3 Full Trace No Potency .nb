             "32fc2533-ab86-6645-b5b8-89c1a526d0a2"]}, Open]], 
        Cell["For u=0, all five independent values are nonzero. They are \
a=-b^2/(2d), c=-b^3/(2d^2), f=b^4/(4d^3). This rank-one matrix can be written \
as a column vector times a row vector. Their scalar product is zero, which \
explains A^2=0. Its Jordan form has blocks of sizes two and one. Every matrix \
in this notebook is nonzero, hence none is diagonalizable: a diagonalizable \
nilpotent matrix would be zero.", "Text", ExpressionUUID -> 
          "2f614d82-1600-1a45-9cc2-3f630b4d3ac5"], 
        Cell[CellGroupData[{Cell[BoxData[{RowBox[{RowBox[{"rankOneRules", 
                  "=", RowBox[{"{", RowBox[{RowBox[{"a", "\[Rule]", RowBox[
                         {"-", FractionBox[SuperscriptBox["b", "2"], RowBox[
                          {"2", " ", "d"}]]}]}], ",", RowBox[{"c", "\[Rule]", 
                        RowBox[{"-", FractionBox[SuperscriptBox["b", "3"], 
                          RowBox[{"2", " ", SuperscriptBox["d", "2"]}]]}]}], 
                      ",", RowBox[{"f", "\[Rule]", FractionBox[SuperscriptBox[
                          "b", "4"], RowBox[{"4", " ", SuperscriptBox["d", 
                          "3"]}]]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
              RowBox[{RowBox[{"columnVector", "=", RowBox[
                   {"squareZeroMatrix", "\[LeftDoubleBracket]", RowBox[
                     {"All", ",", "3"}], "\[RightDoubleBracket]"}]}], ";"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{"rowVector", "=", 
                  RowBox[{"{", RowBox[{RowBox[{"-", FractionBox[
                         SuperscriptBox["b", "2"], RowBox[{"2", " ", 
                          SuperscriptBox["d", "2"]}]]}], ",", FractionBox[
                       "b", "d"], ",", "1"}], "}"}]}], ";"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{"recordCheck", "[", 
                  RowBox[{"\"Rank-one outer product\"", ",", RowBox[
                     {"Simplify", "[", RowBox[{RowBox[{"Outer", "[", RowBox[
                          {"Times", ",", "columnVector", ",", "rowVector"}], 
                          "]"}], "-", "squareZeroMatrix"}], "]"}], ",", 
                    "zero3"}], "]"}], ";"}], "\[IndentingNewLine]", 
              RowBox[{RowBox[{"recordCheck", "[", RowBox[
                   {"\"The inner product vanishes\"", ",", RowBox[
                     {"Simplify", "[", RowBox[{"rowVector", ".", 
                        "columnVector"}], "]"}], ",", "0"}], "]"}], ";"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{"recordCheck", "[", 
                  RowBox[{"\"Rank-one formulas match u zero\"", ",", 
                    RowBox[{"Simplify", "[", RowBox[{RowBox[{"(", RowBox[
                          {"aMatrix", "/.", "\[VeryThinSpace]", 
                          "rankOneRules"}], ")"}], "-", "squareZeroMatrix"}], 
                      "]"}], ",", "zero3"}], "]"}], ";"}], 
              "\[IndentingNewLine]", TagBox[GridBox[
                {{"\"Square-zero matrix\"", TagBox["squareZeroMatrix", 
                   Function[BoxForm`e$, MatrixForm[BoxForm`e$]]]}, 
                 {"\"Column vector\"", "columnVector"}, {"\"Row vector\"", 
                  "rowVector"}, {"\"Row times column\"", RowBox[{"Simplify", 
                    "[", RowBox[{"rowVector", ".", "columnVector"}], "]"}]}}, 
                AutoDelete -> False, GridBoxAlignment -> {"Columns" -> 
                   {{Left}}}, GridBoxItemSize -> {"Columns" -> {{Automatic}}, 
                  "Rows" -> {{Automatic}}}, GridBoxSpacings -> 
                 {"Columns" -> {{2}}, "Rows" -> {{1}}}], "Grid"]}], "Input", 
            InitializationCell -> False, CellLabel -> "In[11]:=", 
            ExpressionUUID -> "4baa7e71-3b0a-404e-a356-cd50b80fec2c"], 
           Cell[BoxData[TagBox[GridBox[{{"\"Square-zero matrix\"", 
                 TagBox[RowBox[{"(", "\[NoBreak]", GridBox[
                     {{RowBox[{"-", FractionBox[SuperscriptBox["b", "2"], 
