             "4ed64d28-e012-5640-abfb-d5b4128f0151"]}, Open]], 
        Cell["The u parameter chooses the signed quadratic branch, so no \
independent plus/minus choice remains. Exact rational b,d,u generate exact \
rational solutions. The formula is a complete solution for b,c,d,f nonzero \
and a arbitrary real. It does not claim a classification with off-diagonal \
zero entries allowed.", "Text", ExpressionUUID -> 
          "b85ea145-e754-6e48-8b7e-5af8e6c1c892"]}, Open]], 
     Cell[CellGroupData[
       {Cell["5. Nilpotency index, rank and an explicit Jordan chain", 
         "Section", ExpressionUUID -> 
          "cd07154f-4745-1444-bcc8-1ff89a7f818f"], Cell["The diagonal \
extension changes the index. The (1,3) entry of A^2 is R=b^2+2ad=b^2u^2. If u \
is nonzero, the square is nonzero and the cube is zero, so the index is \
three. If u=0, the entire square vanishes, not merely that one entry; the \
matrix is nonzero because b,d are nonzero, so its index is two.", "Text", 
         ExpressionUUID -> "c926710e-653a-cf44-b7bc-ed5474fcda05"], 
        Cell[CellGroupData[{Cell[BoxData[{RowBox[{RowBox[{"paramSquare", "=", 
                  RowBox[{"Simplify", "[", RowBox[{"MatrixPower", "[", 
                      RowBox[{"paramMatrix", ",", "2"}], "]"}], "]"}]}], 
                ";"}], "\[IndentingNewLine]", RowBox[{RowBox[
                 {"squareZeroMatrix", "=", RowBox[{"Simplify", "[", 
                    RowBox[{"paramMatrix", "/.", "\[VeryThinSpace]", 
                      RowBox[{"u", "\[Rule]", "0"}]}], "]"}]}], ";"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{"recordCheck", "[", 
                  RowBox[{"\"Decisive square entry\"", ",", RowBox[{"Factor", 
                      "[", RowBox[{"paramSquare", "\[LeftDoubleBracket]", 
                        RowBox[{"1", ",", "3"}], "\[RightDoubleBracket]"}], 
                      "]"}], ",", RowBox[{SuperscriptBox["b", "2"], " ", 
                      SuperscriptBox["u", "2"]}]}], "]"}], ";"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{"recordCheck", "[", 
                  RowBox[{"\"u zero gives square zero\"", ",", RowBox[
                     {"Simplify", "[", RowBox[{"MatrixPower", "[", RowBox[
                         {"squareZeroMatrix", ",", "2"}], "]"}], "]"}], ",", 
                    "zero3"}], "]"}], ";"}], "\[IndentingNewLine]", 
              RowBox[{RowBox[{"rankMinor", "=", RowBox[{"Factor", "[", 
                    RowBox[{"Det", "[", RowBox[{"aMatrix", 
                        "\[LeftDoubleBracket]", RowBox[{RowBox[{"{", RowBox[
                          {"1", ",", "2"}], "}"}], ",", RowBox[{"{", RowBox[
                          {"2", ",", "3"}], "}"}]}], 
                        "\[RightDoubleBracket]"}], "]"}], "]"}]}], ";"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{"recordCheck", "[", 
                  RowBox[{"\"Rank-two minor equals R\"", ",", "rankMinor", 
                    ",", "r2"}], "]"}], ";"}], "\[IndentingNewLine]", 
              RowBox[{RowBox[{"recordCheck", "[", RowBox[
                   {"\"Square-zero branch has rank one\"", ",", RowBox[
                     {"MatrixRank", "[", "squareZeroMatrix", "]"}], ",", 
                    "1"}], "]"}], ";"}], "\[IndentingNewLine]", 
              RowBox[{RowBox[{"recordCheck", "[", RowBox[
                   {"\"General parameterized branch has generic rank two\"", 
                    ",", RowBox[{"MatrixRank", "[", "paramMatrix", "]"}], 
                    ",", "2"}], "]"}], ";"}], "\[IndentingNewLine]", 
              TagBox[GridBox[{{"\"u = 0\"", 
                  "\"Index 2; rank 1; minimal polynomial x^2\""}, 
                 {"\"u != 0\"", 
                  "\"Index 3; rank 2; minimal polynomial x^3\""}, 
                 {"\"A^2 (1,3) entry\"", RowBox[{SuperscriptBox["b", "2"], 
                    " ", SuperscriptBox["u", "2"]}]}}, AutoDelete -> False, 
                GridBoxAlignment -> {"Columns" -> {{Left}}}, 
                GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> 
                   {{Automatic}}}], "Grid"]}], "Input", InitializationCell -> 
             False, CellLabel -> "In[9]:=", ExpressionUUID -> 
             "a70991f9-cb5d-5747-b792-635c1123e487"], 
           Cell[BoxData[TagBox[GridBox[{{"\"u = 0\"", 
                 "\"Index 2; rank 1; minimal polynomial x^2\""}, 
                {"\"u != 0\"", 
                 "\"Index 3; rank 2; minimal polynomial x^3\""}, 
                {"\"A^2 (1,3) entry\"", RowBox[{SuperscriptBox["b", "2"], 
                   " ", SuperscriptBox["u", "2"]}]}}, AutoDelete -> False, 
               GridBoxAlignment -> {"Columns" -> {{Left}}}, 
               GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> 
                  {{Automatic}}}], "Grid"]], "Output", CellLabel -> 
             "Out[9]=", ExpressionUUID -> 
             "b753ed4a-7684-a145-ba67-32cc43a7ae8d"]}, Open]], 
        Cell["For u!=0, the minor R is nonzero while the determinant is zero, \
so rank(A)=2. The Jordan form is one block of size three. Let z=(0,0,1)^T and \
form the basis matrix with columns A^2z, Az, z. Its determinant is -b^3u^3, \
so it is invertible, and in that basis A is the upper shift.", "Text", 
         ExpressionUUID -> "c5d3c0b1-fa03-204b-aeca-65e8a32b77e0"], 
        Cell[CellGroupData[{Cell[BoxData[{RowBox[{RowBox[{"unit3", "=", 
                  RowBox[{"{", RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], 
                ";"}], "\[IndentingNewLine]", RowBox[{RowBox[{"jordanBasis", 
                  "=", TemplateBox[{RowBox[{"{", RowBox[{RowBox[
                         {"paramSquare", ".", "unit3"}], ",", RowBox[
                         {"paramMatrix", ".", "unit3"}], ",", "unit3"}], 
                      "}"}]}, "Transpose"]}], ";"}], "\[IndentingNewLine]", 
              RowBox[{RowBox[{"upperShift", "=", RowBox[{"{", RowBox[
                     {RowBox[{"{", RowBox[{"0", ",", "1", ",", "0"}], "}"}], 
