                         {Offset[0.4]}, Offset[0.2]}}], "\[NoBreak]", ")"}], 
                  Function[BoxForm`e$, MatrixForm[BoxForm`e$]]]}, 
                {"\"Reversal matrix\"", TagBox[RowBox[{"(", "\[NoBreak]", 
                    GridBox[{{"0", "0", "1"}, {"0", "1", "0"}, {"1", "0", 
                       "0"}}, GridBoxAlignment -> {"Columns" -> {{Center}}, 
