     Cell[CellGroupData[
       {Cell["7. Fully classify the nonzero sign arrangements", "Section", 
         ExpressionUUID -> "f66bd4f0-fc7d-7949-9d6d-e27c763b82ab"], 
        Cell["A sign string is in the order (a,b,c,d,f). The middle matrix \
entry automatically has sign opposite to a. If a is nonzero there are 32 \
independent sign arrangements. If a=0 there are another 16. We classify all \
48 here, keeping every off-diagonal entry nonzero throughout.", "Text", 
         ExpressionUUID -> "b79dfa67-f4ea-bb47-84d6-53fa0525ec86"], 
        Cell["The parameterization reduces this to signs of simple \
expressions in u. Relative to d, the sign of a is the sign of u^2-1. Relative \
to b, the sign of c is the sign of 2u-1, because (u+1)^2 is positive on the \
allowed domain. Relative to d, the sign of f is minus the sign of \
(u+1)(3u-1). Split the real u line at the forbidden values -1,1/3,1/2 and at \
1, where a vanishes.", "Text", ExpressionUUID -> 
          "87a9fd63-0acb-fc4a-8385-8c125f12eae6"], 
        Cell[CellGroupData[{Cell[BoxData[{RowBox[{RowBox[{"intervalRows", 
                  "=", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[
                         {"\"u < -1\"", ",", "\"same\"", ",", "\"opposite\"", 
                          ",", "\"opposite\"", ",", "\"3\""}], "}"}], ",", 
                      RowBox[{"{", RowBox[{"\"-1 < u < 1/3\"", ",", 
                          "\"opposite\"", ",", "\"opposite\"", ",", 
                          "\"same\"", ",", "\"2 at u=0; otherwise 3\""}], 
                        "}"}], ",", RowBox[{"{", RowBox[{"\"1/3 < u < 1/2\"", 
                          ",", "\"opposite\"", ",", "\"opposite\"", ",", 
                          "\"opposite\"", ",", "\"3\""}], "}"}], ",", 
                      RowBox[{"{", RowBox[{"\"1/2 < u < 1\"", ",", 
                          "\"opposite\"", ",", "\"same\"", ",", 
                          "\"opposite\"", ",", "\"3\""}], "}"}], ",", 
                      RowBox[{"{", RowBox[{"\"u = 1\"", ",", "\"a is zero\"", 
                          ",", "\"same\"", ",", "\"opposite\"", ",", 
                          "\"3\""}], "}"}], ",", RowBox[{"{", RowBox[
                         {"\"u > 1\"", ",", "\"same\"", ",", "\"same\"", ",", 
                          "\"opposite\"", ",", "\"3\""}], "}"}]}], "}"}]}], 
                ";"}], "\[IndentingNewLine]", RowBox[{RowBox[
                 {"intervalCover", "=", RowBox[{RowBox[{"u", "<", RowBox[
                       {"-", "1"}]}], "||", RowBox[{RowBox[{"-", "1"}], "<", 
                      "u", "<", FractionBox["1", "3"]}], "||", RowBox[
                     {FractionBox["1", "3"], "<", "u", "<", FractionBox["1", 
                       "2"]}], "||", RowBox[{FractionBox["1", "2"], "<", "u", 
                      "<", "1"}], "||", RowBox[{"u", "\[Equal]", "1"}], "||", 
                    RowBox[{"u", ">", "1"}]}]}], ";"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{"recordCheck", "[", 
                  RowBox[
                   {"\"Intervals exhaust the allowed real parameter line\"", 
                    ",", RowBox[{"Resolve", "[", RowBox[{RowBox[{SubscriptBox[
                          "\[ForAll]", RowBox[{"{", "u", "}"}]], RowBox[
                          {"(", RowBox[{"uAllowed", "\[Equivalent]", 
                          "intervalCover"}], ")"}]}], ",", TemplateBox[{}, 
                         "Reals"]}], "]"}], ",", "True"}], "]"}], ";"}], 
              "\[IndentingNewLine]", RowBox[{"Grid", "[", RowBox[
                 {RowBox[{"Prepend", "[", RowBox[{"intervalRows", ",", 
                      RowBox[{"{", RowBox[{"\"Parameter interval\"", ",", 
                          "\"a vs d\"", ",", "\"c vs b\"", ",", "\"f vs d\"", 
                          ",", "\"Nilpotency index\""}], "}"}]}], "]"}], ",", 
                  RowBox[{"Frame", "\[Rule]", "All"}], ",", RowBox[
                   {"Alignment", "\[Rule]", "Left"}]}], "]"}]}], "Input", 
            InitializationCell -> False, CellLabel -> "In[15]:=", 
            ExpressionUUID -> "a6c9ffad-152a-ff45-980b-0f8d4c4064fe"], 
           Cell[BoxData[TagBox[GridBox[{{"\"Parameter interval\"", 
                 "\"a vs d\"", "\"c vs b\"", "\"f vs d\"", 
                 "\"Nilpotency index\""}, {"\"u < -1\"", "\"same\"", 
                 "\"opposite\"", "\"opposite\"", "\"3\""}, 
                {"\"-1 < u < 1/3\"", "\"opposite\"", "\"opposite\"", 
                 "\"same\"", "\"2 at u=0; otherwise 3\""}, 
                {"\"1/3 < u < 1/2\"", "\"opposite\"", "\"opposite\"", 
                 "\"opposite\"", "\"3\""}, {"\"1/2 < u < 1\"", 
