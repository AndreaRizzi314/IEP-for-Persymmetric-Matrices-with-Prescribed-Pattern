        Cell["Each nonzero-a interval profile permits four choices of the \
independent signs of b and d. The five profiles are distinct, so exactly 20 \
of the 32 full-matrix sign arrangements admit nilpotency. The a=0 row gives \
exactly the old four admissible arrangements out of 16. Therefore 24 of the \
combined 48 arrangements admit nilpotency. None forces it for arbitrary \
magnitudes.", "Text", ExpressionUUID -> 
          "0b5fdbab-01e7-8340-b4ac-e46efc7730c7"], 
        Cell[CellGroupData[{Cell[BoxData[{RowBox[{RowBox[{"patternTuples", 
                  "=", RowBox[{"Tuples", "[", RowBox[{"{", RowBox[
                       {RowBox[{"{", RowBox[{RowBox[{"-", "1"}], ",", "0", 
                          ",", "1"}], "}"}], ",", RowBox[{"{", RowBox[
                          {RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
                        RowBox[{"{", RowBox[{RowBox[{"-", "1"}], ",", "1"}], 
                          "}"}], ",", RowBox[{"{", RowBox[{RowBox[{"-", 
                          "1"}], ",", "1"}], "}"}], ",", RowBox[{"{", 
                          RowBox[{RowBox[{"-", "1"}], ",", "1"}], "}"}]}], 
                      "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
              RowBox[{RowBox[{"seedU", "=", RowBox[{"{", RowBox[
                     {RowBox[{"-", "2"}], ",", RowBox[{"-", FractionBox["1", 
                         "2"]}], ",", FractionBox["5", "12"], ",", 
                      FractionBox["3", "4"], ",", "1", ",", "2", ",", "0"}], 
                    "}"}]}], ";"}], "\[IndentingNewLine]", 
              RowBox[{RowBox[{"allWitnessTuples", "=", RowBox[{"Flatten", 
                    "[", RowBox[{RowBox[{"Table", "[", RowBox[{RowBox[
                          {"paramTuple", "[", RowBox[{"sb", ",", "sd", ",", 
                          "uu"}], "]"}], ",", RowBox[{"{", RowBox[{"sb", ",", 
                          RowBox[{"{", RowBox[{RowBox[{"-", "1"}], ",", 
                          "1"}], "}"}]}], "}"}], ",", RowBox[{"{", RowBox[
                          {"sd", ",", RowBox[{"{", RowBox[{RowBox[{"-", 
                          "1"}], ",", "1"}], "}"}]}], "}"}], ",", RowBox[
                          {"{", RowBox[{"uu", ",", "seedU"}], "}"}]}], "]"}], 
                      ",", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
              RowBox[{RowBox[{"patternRows", "=", RowBox[{"Table", "[", 
                    RowBox[{RowBox[{"Module", "[", RowBox[{RowBox[{"{", 
                          RowBox[{"constraint", ",", "possible", ",", 
                          "index2Possible", ",", "index3Possible", ",", 
                          "witness", ",", "witnessExists"}], "}"}], ",", 
                          RowBox[{RowBox[{"constraint", "=", RowBox[{RowBox[
                          {RowBox[{"signConditions", "[", "s", "]"}], "/.", 
                          "\[VeryThinSpace]", "paramRules"}], "/.", 
                          "\[VeryThinSpace]", RowBox[{"{", RowBox[{RowBox[
                          {"b", "\[Rule]", RowBox[{"s", 
                          "\[LeftDoubleBracket]", "2", 
                          "\[RightDoubleBracket]"}]}], ",", RowBox[{"d", 
                          "\[Rule]", RowBox[{"s", "\[LeftDoubleBracket]", 
                          "4", "\[RightDoubleBracket]"}]}]}], "}"}]}]}], ";", 
                          "\[IndentingNewLine]", RowBox[{"possible", "=", 
                          RowBox[{"Resolve", "[", RowBox[{RowBox[
                          {SubscriptBox["\[Exists]", "u"], RowBox[{"(", 
                          RowBox[{"uAllowed", "&&", "constraint"}], ")"}]}], 
                          ",", TemplateBox[{}, "Reals"]}], "]"}]}], ";", 
                          "\[IndentingNewLine]", RowBox[{"index2Possible", 
                          "=", RowBox[{"TrueQ", "[", RowBox[{"constraint", 
                          "/.", "\[VeryThinSpace]", RowBox[{"u", "\[Rule]", 
                          "0"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
                          RowBox[{"index3Possible", "=", RowBox[{"Resolve", 
                          "[", RowBox[{RowBox[{SubscriptBox["\[Exists]", 
                          "u"], RowBox[{"(", RowBox[{"uAllowed", "&&", RowBox[
                          {"u", "\[NotEqual]", "0"}], "&&", "constraint"}], 
                          ")"}]}], ",", TemplateBox[{}, "Reals"]}], "]"}]}], 
                          ";", "\[IndentingNewLine]", RowBox[{"witness", "=", 
                          RowBox[{"SelectFirst", "[", RowBox[
                          {"allWitnessTuples", ",", RowBox[{RowBox[{RowBox[
