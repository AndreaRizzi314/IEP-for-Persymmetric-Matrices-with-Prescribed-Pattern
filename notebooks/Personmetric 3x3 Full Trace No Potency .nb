                         RowBox[{SuperscriptBox["b", "2"], " ", "f"}]}], 
                       RowBox[{RowBox[{"3", " ", SuperscriptBox["a", "2"], 
                          " ", "b"}], "+", RowBox[{"2", " ", SuperscriptBox[
                          "b", "2"], " ", "c"}], "+", RowBox[{"b", " ", "d", 
