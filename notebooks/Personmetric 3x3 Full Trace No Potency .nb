                       "Rows" -> {Offset[0.2], {Offset[0.4]}, Offset[0.2]}}], 
                    "\[NoBreak]", ")"}], Function[BoxForm`e$, MatrixForm[
                    BoxForm`e$]]]}, {"\"Trace condition\"", RowBox[
                  {"{", RowBox[{"{", RowBox[{"e", "\[Rule]", RowBox[
                        {RowBox[{"-", "2"}], " ", "a"}]}], "}"}], "}"}]}}, 
