        Cell["Why this captures EVERY allowed nilpotent matrix: the identity \
in section 3 gives H^2=R^3 and R>=0. If R=0, choose t=0. If R>0, choose \
t=H/R; then t^2=R and t^3=H, as checked above. Set u=t/b, which is valid \
because b is nonzero. From R=b^2+2ad recover a=(t^2-b^2)/(2d). From \
H=cd^2-b^3-3abd recover c=(b^3+3abd+t^3)/d^2. Factor this expression and use \
P=0 to recover f. These are precisely the three displayed formulas. Nonzero \
c,f exclude the three forbidden u values. Conversely the exact substitution \
checks prove every allowed parameter choice is nilpotent.", "Text", 
         ExpressionUUID -> "b852df42-7790-cf41-8372-16013461dd16"], 
        Cell[CellGroupData[{Cell[BoxData[{RowBox[{RowBox[{"aFromT", "=", 
                  FractionBox[RowBox[{SuperscriptBox["t", "2"], "-", 
                     SuperscriptBox["b", "2"]}], RowBox[{"2", " ", "d"}]]}], 
                ";"}], "\[IndentingNewLine]", RowBox[{RowBox[{"cFromT", "=", 
                  RowBox[{"Factor", "[", FractionBox[RowBox[{SuperscriptBox[
                        "b", "3"], "+", RowBox[{"3", " ", "aFromT", " ", "b", 
                         " ", "d"}], "+", SuperscriptBox["t", "3"]}], 
                     SuperscriptBox["d", "2"]], "]"}]}], ";"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{"fFromT", "=", 
                  RowBox[{"Factor", "[", RowBox[{"-", FractionBox[RowBox[
                        {RowBox[{"3", " ", SuperscriptBox["aFromT", "2"]}], 
                         "+", RowBox[{"2", " ", "b", " ", "cFromT"}]}], 
                       "d"]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
              RowBox[{RowBox[{"recordCheck", "[", RowBox[
                   {"\"Reconstruct a from R\"", ",", RowBox[{"Together", "[", 
                      RowBox[{FractionBox[RowBox[{"r2", "-", SuperscriptBox[
                          "b", "2"]}], RowBox[{"2", " ", "d"}]], "-", "a"}], 
                      "]"}], ",", "0"}], "]"}], ";"}], "\[IndentingNewLine]", 
              RowBox[{RowBox[{"recordCheck", "[", RowBox[
                   {"\"Reconstruct c from H\"", ",", RowBox[{"Together", "[", 
                      RowBox[{FractionBox[RowBox[{SuperscriptBox["b", "3"], 
                          "+", RowBox[{"3", " ", "a", " ", "b", " ", "d"}], 
                          "+", "h3"}], SuperscriptBox["d", "2"]], "-", "c"}], 
                      "]"}], ",", "0"}], "]"}], ";"}], "\[IndentingNewLine]", 
              RowBox[{RowBox[{"recordCheck", "[", RowBox[
                   {"\"Reconstruct f from P\"", ",", RowBox[{"Together", "[", 
                      RowBox[{"f", "+", FractionBox[RowBox[{RowBox[{"3", " ", 
                          SuperscriptBox["a", "2"]}], "+", RowBox[{"2", " ", 
                          "b", " ", "c"}]}], "d"], "-", FractionBox["p2", 
                         "d"]}], "]"}], ",", "0"}], "]"}], ";"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{"recordCheck", "[", 
                  RowBox[
                   {"\"Signed-root reconstruction gives the same \
parameters\"", ",", RowBox[{"Together", "[", RowBox[{RowBox[{"(", RowBox[
                          {RowBox[{"{", RowBox[{"aFromT", ",", "cFromT", ",", 
                          "fFromT"}], "}"}], "/.", "\[VeryThinSpace]", 
                          RowBox[{"t", "\[Rule]", RowBox[{"b", " ", 
                          "u"}]}]}], ")"}], "-", RowBox[{"(", RowBox[
                          {RowBox[{"{", RowBox[{"a", ",", "c", ",", "f"}], 
                          "}"}], "/.", "\[VeryThinSpace]", "paramRules"}], 
                          ")"}]}], "]"}], ",", RowBox[{"{", RowBox[{"0", ",", 
                        "0", ",", "0"}], "}"}]}], "]"}], ";"}], 
              "\[IndentingNewLine]", TagBox[GridBox[{{"\"a from t\"", 
                  "aFromT"}, {"\"c from t\"", "cFromT"}, {"\"f from t\"", 
                  "fFromT"}}, AutoDelete -> False, GridBoxAlignment -> 
                 {"Columns" -> {{Left}}}, GridBoxItemSize -> 
                 {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
               "Grid"]}], "Input", InitializationCell -> False, 
            CellLabel -> "In[8]:=", ExpressionUUID -> 
             "65b397db-fff4-0448-858e-748a54439cbb"], 
           Cell[BoxData[TagBox[GridBox[{{"\"a from t\"", FractionBox[
                  RowBox[{RowBox[{"-", SuperscriptBox["b", "2"]}], "+", 
                    SuperscriptBox["t", "2"]}], RowBox[{"2", " ", "d"}]]}, 
                {"\"c from t\"", RowBox[{"-", FractionBox[RowBox[
                     {RowBox[{"(", RowBox[{"b", "-", RowBox[{"2", " ", 
                          "t"}]}], ")"}], " ", SuperscriptBox[RowBox[
                        {"(", RowBox[{"b", "+", "t"}], ")"}], "2"]}], 
                    RowBox[{"2", " ", SuperscriptBox["d", "2"]}]]}]}, 
                {"\"f from t\"", FractionBox[RowBox[{RowBox[{"(", RowBox[
