             "c617440f-67b7-1049-879c-807bbaf12cf2"]}, Open]], 
        Cell["The helper functions keep the calculations readable: mat builds \
a matrix from {a,b,c,d,f}; zeroMatrixQ checks every entry; monicChar computes \
det(x I-A); recordCheck stores an exact check; signText formats the five \
independent signs; signConditions encodes a sign pattern; nilIndex finds the \
first zero power. CellContext -> Notebook keeps these definitions separate \
from other notebooks.", "Text", ExpressionUUID -> 
          "affae084-c364-0945-bb1c-cc8e527ac789"]}, Open]], 
     Cell[CellGroupData[
       {Cell["2. Multiply A and derive the nilpotency equations", "Section", 
         ExpressionUUID -> "cc064857-7fff-414b-ab45-0d111637b12d"], 
        Cell["A^2 means A multiplied by A. In its (1,3) position, the \
row-column product is a*d+b*b+d*a = b^2+2ad. In its (2,2) position it is \
c*b+(-2a)*(-2a)+b*c = 4a^2+2bc. The cell below computes the entire square and \
cube exactly.", "Text", ExpressionUUID -> 
          "46dfd0d9-acdd-6a4c-b26a-7fa21bc5f910"], 
        Cell[CellGroupData[{Cell[BoxData[{RowBox[{RowBox[{"aSquare", "=", 
                  RowBox[{"Expand", "[", RowBox[{"MatrixPower", "[", 
                      RowBox[{"aMatrix", ",", "2"}], "]"}], "]"}]}], ";"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{"aCube", "=", 
                  RowBox[{"Expand", "[", RowBox[{"MatrixPower", "[", 
                      RowBox[{"aMatrix", ",", "3"}], "]"}], "]"}]}], ";"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{"p2", "=", RowBox[
                   {RowBox[{"3", " ", SuperscriptBox["a", "2"]}], "+", 
                    RowBox[{"2", " ", "b", " ", "c"}], "+", RowBox[{"d", " ", 
                      "f"}]}]}], ";"}], "\[IndentingNewLine]", 
              RowBox[{RowBox[{"q3", "=", RowBox[{RowBox[{RowBox[{"-", "2"}], 
                      " ", SuperscriptBox["a", "3"]}], "-", RowBox[{"2", " ", 
                      "a", " ", "b", " ", "c"}], "+", RowBox[{SuperscriptBox[
                       "b", "2"], " ", "f"}], "+", RowBox[{SuperscriptBox[
                       "c", "2"], " ", "d"}], "+", RowBox[{"2", " ", "a", 
                      " ", "d", " ", "f"}]}]}], ";"}], "\[IndentingNewLine]", 
              RowBox[{RowBox[{"nilConditions", "=", RowBox[{RowBox[{"p2", 
                      "\[Equal]", "0"}], "&&", RowBox[{"q3", "\[Equal]", 
                      "0"}]}]}], ";"}], "\[IndentingNewLine]", 
              RowBox[{RowBox[{"expectedSquare", "=", RowBox[{"{", RowBox[
                     {RowBox[{"{", RowBox[{RowBox[{SuperscriptBox["a", "2"], 
                          "+", RowBox[{"b", " ", "c"}], "+", RowBox[{"d", 
                          " ", "f"}]}], ",", RowBox[{RowBox[{"c", " ", "d"}], 
                          "-", RowBox[{"a", " ", "b"}]}], ",", RowBox[
                          {SuperscriptBox["b", "2"], "+", RowBox[{"2", " ", 
                          "a", " ", "d"}]}]}], "}"}], ",", RowBox[{"{", 
                        RowBox[{RowBox[{RowBox[{"b", " ", "f"}], "-", RowBox[
                          {"a", " ", "c"}]}], ",", RowBox[{RowBox[{"4", " ", 
                          SuperscriptBox["a", "2"]}], "+", RowBox[{"2", " ", 
                          "b", " ", "c"}]}], ",", RowBox[{RowBox[{"c", " ", 
                          "d"}], "-", RowBox[{"a", " ", "b"}]}]}], "}"}], 
                      ",", RowBox[{"{", RowBox[{RowBox[{SuperscriptBox["c", 
                          "2"], "+", RowBox[{"2", " ", "a", " ", "f"}]}], 
                          ",", RowBox[{RowBox[{"b", " ", "f"}], "-", RowBox[
                          {"a", " ", "c"}]}], ",", RowBox[{SuperscriptBox[
                          "a", "2"], "+", RowBox[{"b", " ", "c"}], "+", 
                          RowBox[{"d", " ", "f"}]}]}], "}"}]}], "}"}]}], 
                ";"}], "\[IndentingNewLine]", RowBox[{RowBox[{"recordCheck", 
                  "[", RowBox[{"\"Explicit square\"", ",", "aSquare", ",", 
                    "expectedSquare"}], "]"}], ";"}], "\[IndentingNewLine]", 
              RowBox[{RowBox[{"recordCheck", "[", RowBox[
