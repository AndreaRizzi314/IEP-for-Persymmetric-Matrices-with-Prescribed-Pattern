                          ";", "\[IndentingNewLine]", RowBox[
                          {"witnessExists", "=", RowBox[{"ListQ", "[", 
                          "witness", "]"}]}], ";", "\[IndentingNewLine]", 
                          RowBox[{"recordCheck", "[", RowBox[{RowBox[
                          {"\"Sign decision \"", "<>", RowBox[{"signText", 
                          "[", "s", "]"}]}], ",", "possible", ",", 
                          "witnessExists"}], "]"}], ";", 
                          "\[IndentingNewLine]", RowBox[{"Association", "[", 
                          RowBox[{RowBox[{"\"Signs (a,b,c,d,f)\"", "\[Rule]", 
                          RowBox[{"signText", "[", "s", "]"}]}], ",", RowBox[
                          {"\"Admits nilpotency\"", "\[Rule]", "possible"}], 
                          ",", RowBox[{"\"Admits index 2\"", "\[Rule]", 
                          "index2Possible"}], ",", RowBox[
                          {"\"Admits index 3\"", "\[Rule]", 
                          "index3Possible"}], ",", RowBox[{"\"Witness\"", 
                          "\[Rule]", RowBox[{"If", "[", RowBox[
                          {"witnessExists", ",", "witness", ",", 
