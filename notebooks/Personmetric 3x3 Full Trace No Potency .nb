            InitializationCell -> False, CellLabel -> "In[2]:=", 
            ExpressionUUID -> "52128175-760a-db40-9c68-509dbd5eee18"], 
           Cell[BoxData[TagBox[GridBox[{{"\"A^2\"", TagBox[RowBox[
                   {"(", "\[NoBreak]", GridBox[{{RowBox[{SuperscriptBox["a", 
                          "2"], "+", RowBox[{"b", " ", "c"}], "+", RowBox[
