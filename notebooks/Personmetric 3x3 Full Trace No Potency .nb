                          "\[LeftDoubleBracket]", "i", 
                          "\[RightDoubleBracket]"}], "]"}]}], "}"}], ",", 
                          RowBox[{"{", RowBox[{"i", ",", "2"}], "}"}]}], 
                        "]"}], ",", RowBox[{"{", RowBox[
                         {"\"Tuple (a,b,c,d,f)\"", ",", "\"Matrix\"", ",", 
