                          "aMatrix"}], "-", RowBox[{"q3", " ", RowBox[
                          {"IdentityMatrix", "[", "3", "]"}]}]}], "]"}], ",", 
                    "zero3"}], "]"}], ";"}], "\[IndentingNewLine]", 
