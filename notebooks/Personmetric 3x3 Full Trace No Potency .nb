        Cell["Preserving signs and the trace is insufficient. In the \
index-two example change f from -4 to -3. The trace and every sign stay the \
same, but P=-1 and Q=0. The characteristic polynomial becomes x^3+x and the \
matrix is not nilpotent.", "Text", ExpressionUUID -> 
          "fcbaec30-89b0-874d-b527-72979c6c0f19"], 
        Cell[CellGroupData[{Cell[BoxData[{RowBox[{RowBox[{"perturbed", "=", 
                  RowBox[{"mat", "[", RowBox[{"{", RowBox[{"2", ",", "2", 
                        ",", RowBox[{"-", "4"}], ",", RowBox[{"-", "1"}], 
                        ",", RowBox[{"-", "3"}]}], "}"}], "]"}]}], ";"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{"recordCheck", "[", 
                  RowBox[{"\"Perturbation preserves all signs\"", ",", 
                    RowBox[{"Sign", "[", "perturbed", "]"}], ",", RowBox[
                     {"Sign", "[", "index2Example", "]"}]}], "]"}], ";"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{"recordCheck", "[", 
                  RowBox[{"\"Perturbation trace\"", ",", RowBox[{"Tr", "[", 
                      "perturbed", "]"}], ",", "0"}], "]"}], ";"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{"recordCheck", "[", 
                  RowBox[{"\"Perturbation characteristic polynomial\"", ",", 
                    RowBox[{"monicChar", "[", RowBox[{"perturbed", ",", 
                        "x"}], "]"}], ",", RowBox[{SuperscriptBox["x", "3"], 
                      "+", "x"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
              RowBox[{RowBox[{"recordCheck", "[", RowBox[
                   {"\"Perturbation is not nilpotent\"", ",", RowBox[
                     {"zeroMatrixQ", "[", RowBox[{"MatrixPower", "[", 
                        RowBox[{"perturbed", ",", "3"}], "]"}], "]"}], ",", 
                    "False"}], "]"}], ";"}], "\[IndentingNewLine]", 
              RowBox[{"{", RowBox[{TagBox["perturbed", Function[BoxForm`e$, 
                    MatrixForm[BoxForm`e$]]], ",", RowBox[{"monicChar", "[", 
                    RowBox[{"perturbed", ",", "x"}], "]"}], ",", 
                  TagBox[RowBox[{"MatrixPower", "[", RowBox[{"perturbed", 
                       ",", "3"}], "]"}], Function[BoxForm`e$, MatrixForm[
                     BoxForm`e$]]]}], "}"}]}], "Input", InitializationCell -> 
             False, CellLabel -> "In[14]:=", ExpressionUUID -> 
             "a9cb0848-1689-a747-aefa-d538db2384c0"], 
           Cell[BoxData[RowBox[{"{", RowBox[{TagBox[RowBox[{"(", 
