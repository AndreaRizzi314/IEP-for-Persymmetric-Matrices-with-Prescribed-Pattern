Notebook[{Cell[CellGroupData[{Cell["Personmetric 3x3 Full Trace No Potency", 
      "Title", ExpressionUUID -> "9b076cf3-99bc-7642-a1af-5b53532c712e"], 
     Cell[CellGroupData[
       {Cell["1. The entire matrix: retain the trace constraint", "Section", 
         ExpressionUUID -> "7c99aec8-2ec6-8e46-ae5b-c2315ea569d4"], 
        Cell["This is the companion to persymmetric_3x3_zero_diagonal.nb. We \
now allow the diagonal to be nonzero, while retaining persymmetry and the \
requirement that b,c,d,f are all nonzero real numbers. The value a is real; \
a=0 is the earlier notebook's family. When we specifically discuss the entire \
all-nonzero matrix, a is also required to be nonzero.", "Text", 
         ExpressionUUID -> "f67f5414-592a-594e-b160-03d650ef98ee"], 
        Cell[BoxData[FormBox[TagBox[RowBox[{"G", "\[LongEqual]", 
              RowBox[{"(", "\[NoBreak]", GridBox[{{"a", "b", "d"}, 
                  {"c", "e", "b"}, {"f", "c", "a"}}, GridBoxAlignment -> 
                  {"Columns" -> {{Center}}, "Rows" -> {{Baseline}}}, 
                 GridBoxSpacings -> {"Columns" -> {Offset[
                      0.27999999999999997], {Offset[0.7]}, Offset[
                      0.27999999999999997]}, "Rows" -> {Offset[0.2], 
                     {Offset[0.4]}, Offset[0.2]}}], "\[NoBreak]", ")"}]}], 
            HoldForm], TraditionalForm]], "DisplayFormula", 
         ExpressionUUID -> "90cdaf49-0708-c14f-8524-0b32ba5799f1"], 
        Cell["Nilpotency forces the trace, the sum of the diagonal entries, \
to vanish. For the general persymmetric matrix above this is 2a+e=0, so \
e=-2a. This reduces six independent values to the five parameters a,b,c,d,f. \
The trace condition alone does not imply nilpotency.", "Text", 
         ExpressionUUID -> "f6aedd3e-139c-6e4a-8c10-bc56e011e449"], 
        Cell[BoxData[FormBox[TagBox[RowBox[{"A", "\[LongEqual]", 
              RowBox[{"(", "\[NoBreak]", GridBox[{{"a", "b", "d"}, 
                  {"c", RowBox[{RowBox[{"-", "2"}], " ", "a"}], "b"}, 
                  {"f", "c", "a"}}, GridBoxAlignment -> {"Columns" -> 
                    {{Center}}, "Rows" -> {{Baseline}}}, GridBoxSpacings -> 
                  {"Columns" -> {Offset[0.27999999999999997], {Offset[0.7]}, 
                     Offset[0.27999999999999997]}, "Rows" -> {Offset[0.2], 
                     {Offset[0.4]}, Offset[0.2]}}], "\[NoBreak]", ")"}]}], 
            HoldForm], TraditionalForm]], "DisplayFormula", 
         ExpressionUUID -> "9fc5d98d-eb41-4d43-bf30-938877ff78f4"], 
        Cell[CellGroupData[{Cell[BoxData[{RowBox[{RowBox[{"ClearAll", "[", 
                  "\"`*\"", "]"}], ";"}], "\[IndentingNewLine]", 
              RowBox[{RowBox[{"vars", "=", RowBox[{"{", RowBox[{"a", ",", 
                      "b", ",", "c", ",", "d", ",", "f"}], "}"}]}], ";"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{"realAssumptions", "=", 
                  RowBox[{"vars", "\[Element]", TemplateBox[{}, "Reals"]}]}], 
                ";"}], "\[IndentingNewLine]", RowBox[{RowBox[{"offNonzero", 
                  "=", RowBox[{RowBox[{"b", "\[NotEqual]", "0"}], "&&", 
                    RowBox[{"c", "\[NotEqual]", "0"}], "&&", RowBox[
                     {"d", "\[NotEqual]", "0"}], "&&", RowBox[{"f", 
                      "\[NotEqual]", "0"}]}]}], ";"}], "\[IndentingNewLine]", 
              RowBox[{RowBox[{"denseAssumptions", "=", RowBox[
                   {"realAssumptions", "&&", "offNonzero"}]}], ";"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{"fullAssumptions", "=", 
                  RowBox[{"denseAssumptions", "&&", RowBox[{"a", 
                      "\[NotEqual]", "0"}]}]}], ";"}], "\[IndentingNewLine]", 
              RowBox[{RowBox[{"generalMatrix", "=", RowBox[{"{", RowBox[
                     {RowBox[{"{", RowBox[{"a", ",", "b", ",", "d"}], "}"}], 
                      ",", RowBox[{"{", RowBox[{"c", ",", "e", ",", "b"}], 
                        "}"}], ",", RowBox[{"{", RowBox[{"f", ",", "c", ",", 
                          "a"}], "}"}]}], "}"}]}], ";"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{"aMatrix", "=", 
                  RowBox[{"generalMatrix", "/.", "\[VeryThinSpace]", 
                    RowBox[{"e", "\[Rule]", RowBox[{RowBox[{"-", "2"}], " ", 
                        "a"}]}]}]}], ";"}], "\[IndentingNewLine]", 
              RowBox[{RowBox[{"j3", "=", RowBox[{"Reverse", "[", RowBox[
                     {"IdentityMatrix", "[", "3", "]"}], "]"}]}], ";"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{"zero3", "=", 
                  RowBox[{"ConstantArray", "[", RowBox[{"0", ",", RowBox[
                       {"{", RowBox[{"3", ",", "3"}], "}"}]}], "]"}]}], 
                ";"}], "\[IndentingNewLine]", RowBox[{RowBox[{"checks", "=", 
                  RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
              RowBox[{RowBox[{RowBox[{"recordCheck", "[", RowBox[
                     {"name_String", ",", "actual_", ",", "expected_"}], 
                    "]"}], ":=", RowBox[{"Module", "[", RowBox[
                     {RowBox[{"{", RowBox[{"passed", "=", RowBox[{"actual", 
                          "===", "expected"}]}], "}"}], ",", RowBox[
                       {RowBox[{"AppendTo", "[", RowBox[{"checks", ",", 
                          RowBox[{"Association", "[", RowBox[{RowBox[
                          {"\"Check\"", "\[Rule]", "name"}], ",", RowBox[
                          {"\"Passed\"", "\[Rule]", "passed"}], ",", RowBox[
                          {"\"Actual\"", "\[Rule]", RowBox[{"ToString", "[", 
                          RowBox[{"actual", ",", "InputForm"}], "]"}]}], ",", 
                          RowBox[{"\"Expected\"", "\[Rule]", RowBox[
                          {"ToString", "[", RowBox[{"expected", ",", 
                          "InputForm"}], "]"}]}]}], "]"}]}], "]"}], ";", 
                        "\[IndentingNewLine]", "passed"}]}], "]"}]}], ";"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{RowBox[{"zeroMatrixQ", 
                    "[", "m_List", "]"}], ":=", RowBox[{"And", "@@", 
                    RowBox[{RowBox[{"(", RowBox[{RowBox[{"TrueQ", "[", 
                          RowBox[{"#1", "\[Equal]", "0"}], "]"}], "&"}], 
                        ")"}], "/@", RowBox[{"Flatten", "[", "m", 
                        "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
              RowBox[{RowBox[{RowBox[{"monicChar", "[", RowBox[{"m_List", 
                      ",", "z_"}], "]"}], ":=", RowBox[{"Expand", "[", 
                    RowBox[{"Det", "[", RowBox[{RowBox[{"z", " ", RowBox[
                          {"IdentityMatrix", "[", RowBox[{"Length", "[", "m", 
                          "]"}], "]"}]}], "-", "m"}], "]"}], "]"}]}], ";"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{RowBox[{"mat", "[", 
                    "v_List", "]"}], ":=", RowBox[{"{", RowBox[
                     {RowBox[{"{", RowBox[{RowBox[{"v", 
                          "\[LeftDoubleBracket]", "1", 
                          "\[RightDoubleBracket]"}], ",", RowBox[{"v", 
                          "\[LeftDoubleBracket]", "2", 
                          "\[RightDoubleBracket]"}], ",", RowBox[{"v", 
                          "\[LeftDoubleBracket]", "4", 
                          "\[RightDoubleBracket]"}]}], "}"}], ",", RowBox[
                       {"{", RowBox[{RowBox[{"v", "\[LeftDoubleBracket]", 
                          "3", "\[RightDoubleBracket]"}], ",", RowBox[
                          {RowBox[{"-", "2"}], " ", RowBox[{"v", 
                          "\[LeftDoubleBracket]", "1", 
                          "\[RightDoubleBracket]"}]}], ",", RowBox[{"v", 
                          "\[LeftDoubleBracket]", "2", 
                          "\[RightDoubleBracket]"}]}], "}"}], ",", RowBox[
                       {"{", RowBox[{RowBox[{"v", "\[LeftDoubleBracket]", 
                          "5", "\[RightDoubleBracket]"}], ",", RowBox[
                          {"v", "\[LeftDoubleBracket]", "3", 
                          "\[RightDoubleBracket]"}], ",", RowBox[{"v", 
                          "\[LeftDoubleBracket]", "1", 
                          "\[RightDoubleBracket]"}]}], "}"}]}], "}"}]}], 
                ";"}], "\[IndentingNewLine]", RowBox[{RowBox[
                 {RowBox[{"signText", "[", "v_List", "]"}], ":=", 
                  RowBox[{"StringJoin", "[", RowBox[{RowBox[{"(", RowBox[
                         {RowBox[{"Switch", "[", RowBox[{RowBox[{"Sign", "[", 
                          "#1", "]"}], ",", RowBox[{"-", "1"}], ",", "\"-\"", 
                          ",", "0", ",", "\"0\"", ",", "1", ",", "\"+\""}], 
                          "]"}], "&"}], ")"}], "/@", "v"}], "]"}]}], ";"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{RowBox[
                   {"signConditions", "[", "s_List", "]"}], ":=", 
                  RowBox[{"And", "@@", RowBox[{"MapThread", "[", RowBox[
                       {RowBox[{RowBox[{"Switch", "[", RowBox[{"#2", ",", 
                          RowBox[{"-", "1"}], ",", RowBox[{"#1", "<", "0"}], 
                          ",", "0", ",", RowBox[{"#1", "\[Equal]", "0"}], 
                          ",", "1", ",", RowBox[{"#1", ">", "0"}]}], "]"}], 
                          "&"}], ",", RowBox[{"{", RowBox[{"vars", ",", 
                          "s"}], "}"}]}], "]"}]}]}], ";"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{RowBox[{"nilIndex", "[", 
                    "m_List", "]"}], ":=", RowBox[{"Which", "[", RowBox[
                     {RowBox[{"zeroMatrixQ", "[", "m", "]"}], ",", "1", ",", 
                      RowBox[{"zeroMatrixQ", "[", RowBox[{"MatrixPower", "[", 
                          RowBox[{"m", ",", "2"}], "]"}], "]"}], ",", "2", 
                      ",", RowBox[{"zeroMatrixQ", "[", RowBox[{"MatrixPower", 
                          "[", RowBox[{"m", ",", "3"}], "]"}], "]"}], ",", 
                      "3", ",", "True", ",", RowBox[{"Missing", "[", 
                        "\"NotNilpotent\"", "]"}]}], "]"}]}], ";"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{"recordCheck", "[", 
                  RowBox[{"\"General trace\"", ",", RowBox[{"Tr", "[", 
                      "generalMatrix", "]"}], ",", RowBox[{RowBox[{"2", " ", 
                        "a"}], "+", "e"}]}], "]"}], ";"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{"recordCheck", "[", 
                  RowBox[{"\"Trace-zero diagonal\"", ",", RowBox[{"Tr", "[", 
                      "aMatrix", "]"}], ",", "0"}], "]"}], ";"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{"recordCheck", "[", 
                  RowBox[{"\"Persymmetry\"", ",", RowBox[{"aMatrix", 
                      "\[Equal]", RowBox[{"j3", ".", TemplateBox[{"aMatrix"}, 
                         "Transpose"], ".", "j3"}]}], ",", "True"}], "]"}], 
                ";"}], "\[IndentingNewLine]", TagBox[GridBox[
                {{"\"The new matrix\"", TagBox["aMatrix", Function[
                    BoxForm`e$, MatrixForm[BoxForm`e$]]]}, 
                 {"\"Reversal matrix\"", TagBox["j3", Function[BoxForm`e$, 
                    MatrixForm[BoxForm`e$]]]}, {"\"Trace condition\"", 
                  RowBox[{"Solve", "[", RowBox[{RowBox[{RowBox[{"Tr", "[", 
                          "generalMatrix", "]"}], "\[Equal]", "0"}], ",", 
                      "e"}], "]"}]}}, AutoDelete -> False, 
                GridBoxAlignment -> {"Columns" -> {{Left}}}, 
                GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> 
                   {{Automatic}}}, GridBoxSpacings -> {"Columns" -> {{2}}, 
                  "Rows" -> {{1}}}], "Grid"]}], "Input", 
            InitializationCell -> True, CellLabel -> "In[1]:=", 
            ExpressionUUID -> "37f78b21-b349-534d-93b4-04c47b4555e0"], 
           Cell[BoxData[TagBox[GridBox[{{"\"The new matrix\"", TagBox[
                  RowBox[{"(", "\[NoBreak]", GridBox[{{"a", "b", "d"}, 
                      {"c", RowBox[{RowBox[{"-", "2"}], " ", "a"}], "b"}, 
                      {"f", "c", "a"}}, GridBoxAlignment -> {"Columns" -> 
                        {{Center}}, "Rows" -> {{Baseline}}}, 
                     GridBoxSpacings -> {"Columns" -> {Offset[
                          0.27999999999999997], {Offset[0.7]}, Offset[
