     Cell[CellGroupData[{Cell["6. Worked matrices, including both indices", 
         "Section", ExpressionUUID -> 
          "118d838f-9272-fe4a-88d4-0cc7d65f522a"], Cell["A small integer \
square-zero example uses a=2,b=2,c=-4,d=-1,f=-4. Its trace is 2-4+2=0. The \
first cancellation is 3*(2)^2+2*(2)*(-4)+(-1)*(-4)=12-16+4=0. The determinant \
cancellation is -16+32-16-16+16=0. All nine matrix positions are nonzero.", 
         "Text", ExpressionUUID -> "b4b21a88-5076-9249-8b9b-deb570fb7ff4"], 
        Cell[CellGroupData[{Cell[BoxData[{RowBox[{RowBox[{"index2Example", 
                  "=", RowBox[{"mat", "[", RowBox[{"{", RowBox[{"2", ",", 
                        "2", ",", RowBox[{"-", "4"}], ",", RowBox[{"-", 
                          "1"}], ",", RowBox[{"-", "4"}]}], "}"}], "]"}]}], 
                ";"}], "\[IndentingNewLine]", RowBox[{RowBox[{"recordCheck", 
                  "[", RowBox[{"\"Index-two example parameterization\"", ",", 
                    RowBox[{"paramTuple", "[", RowBox[{"2", ",", RowBox[
                         {"-", "1"}], ",", "0"}], "]"}], ",", RowBox[
                     {"{", RowBox[{"2", ",", "2", ",", RowBox[{"-", "4"}], 
                        ",", RowBox[{"-", "1"}], ",", RowBox[{"-", "4"}]}], 
                      "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
