                    RowBox[{"Expand", "[", RowBox[{"2", " ", "p2"}], "]"}]}], 
                  "]"}], ";"}], "\[IndentingNewLine]", RowBox[{
                RowBox[{"recordCheck", "[", RowBox[
                   {"\"Trace of cube equals 3Q\"", ",", RowBox[{"Expand", 
                      "[", RowBox[{"Tr", "[", "aCube", "]"}], "]"}], ",", 
                    RowBox[{"Expand", "[", RowBox[{"3", " ", "q3"}], "]"}]}], 
                  "]"}], ";"}], "\[IndentingNewLine]", RowBox[{
                RowBox[{"recordCheck", "[", RowBox[
                   {"\"Determinant equals Q\"", ",", RowBox[{"Expand", "[", 
                      RowBox[{"Det", "[", "aMatrix", "]"}], "]"}], ",", 
                    "q3"}], "]"}], ";"}], "\[IndentingNewLine]", 
              TagBox[GridBox[{{"\"A^2\"", TagBox["aSquare", Function[
                    BoxForm`e$, MatrixForm[BoxForm`e$]]]}, {"\"A^3\"", 
