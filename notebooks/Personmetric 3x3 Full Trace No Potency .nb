                   RowBox[{"d", " ", "f"}]}]}, {"\"Q\"", RowBox[
                  {RowBox[{RowBox[{"-", "2"}], " ", SuperscriptBox["a", 
                      "3"]}], "-", RowBox[{"2", " ", "a", " ", "b", " ", 
                     "c"}], "+", RowBox[{SuperscriptBox["c", "2"], " ", 
                     "d"}], "+", RowBox[{SuperscriptBox["b", "2"], " ", 
                     "f"}], "+", RowBox[{"2", " ", "a", " ", "d", " ", 
                     "f"}]}]}}, AutoDelete -> False, GridBoxAlignment -> 
                {"Columns" -> {{Left}}}, GridBoxItemSize -> 
                {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}, 
               GridBoxSpacings -> {"Columns" -> {{2}}, "Rows" -> {{1}}}], 
              "Grid"]], "Output", CellLabel -> "Out[2]=", ExpressionUUID -> 
             "cf8dd440-b640-7a4a-895a-d6a42f50401d"]}, Open]], 
        Cell[BoxData[FormBox[TagBox[RowBox[{"P", "\[LongEqual]", 
              RowBox[{RowBox[{"3", " ", SuperscriptBox["a", "2"]}], "+", 
                RowBox[{"2", " ", "b", " ", "c"}], "+", RowBox[{"d", " ", 
                  "f"}]}]}], HoldForm], TraditionalForm]], "DisplayFormula", 
         ExpressionUUID -> "91e018f8-43c3-4549-afcd-4661bfffc355"], 
        Cell[BoxData[FormBox[TagBox[RowBox[{"Q", "\[LongEqual]", 
              RowBox[{RowBox[{RowBox[{"-", "2"}], " ", SuperscriptBox["a", 
                   "3"]}], "-", RowBox[{"2", " ", "a", " ", "b", " ", "c"}], 
                "+", RowBox[{SuperscriptBox["b", "2"], " ", "f"}], "+", 
                RowBox[{SuperscriptBox["c", "2"], " ", "d"}], "+", 
                RowBox[{"2", " ", "a", " ", "d", " ", "f"}]}]}], HoldForm], 
           TraditionalForm]], "DisplayFormula", ExpressionUUID -> 
          "c5d16c5e-7ee6-974b-8ea2-52cac68bca2f"], 
        Cell[BoxData[FormBox[TagBox[RowBox[{RowBox[{"MatrixPower", "[", 
                RowBox[{"A", ",", "3"}], "]"}], "\[LongEqual]", 
              RowBox[{RowBox[{"P", " ", "A"}], "+", RowBox[{"Q", " ", 
                  RowBox[{"IdentityMatrix", "[", "3", "]"}]}]}]}], HoldForm], 
           TraditionalForm]], "DisplayFormula", ExpressionUUID -> 
          "88a7fbe3-9fde-684d-9186-2e417f169eea"], Cell["For a 3 by 3 matrix, \
nilpotency is equivalent to A^3=0. Taking the trace of the cube identity \
gives 3Q=0 because Tr(A)=0. Then P A=0. If A is nonzero, P must be zero; for \
the zero matrix P is already zero. Thus P=0 and Q=0 are necessary AND \
sufficient. The following equivalence holds even when entries vanish, \
although our main solution continues to require b,c,d,f nonzero.", "Text", 
         ExpressionUUID -> "73acebac-be81-c942-b521-7a25dd84467e"], 
        Cell[CellGroupData[{Cell[BoxData[{RowBox[{RowBox[{"cubeZero", "=", 
                  RowBox[{"And", "@@", RowBox[{RowBox[{"(", RowBox[
                         {RowBox[{"#1", "\[Equal]", "0"}], "&"}], ")"}], 
                      "/@", RowBox[{"Flatten", "[", "aCube", "]"}]}]}]}], 
                ";"}], "\[IndentingNewLine]", RowBox[{RowBox[{"recordCheck", 
                  "[", RowBox[
                   {"\"A cubed zero iff both coefficient conditions hold\"", 
                    ",", RowBox[{"Resolve", "[", RowBox[{RowBox[{SubscriptBox[
                          "\[ForAll]", RowBox[{"{", RowBox[{"a", ",", "b", 
                          ",", "c", ",", "d", ",", "f"}], "}"}]], RowBox[
                          {"(", RowBox[{"cubeZero", "\[Equivalent]", 
                          "nilConditions"}], ")"}]}], ",", TemplateBox[{}, 
                         "Reals"]}], "]"}], ",", "True"}], "]"}], ";"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{"chi", "=", 
                  RowBox[{"monicChar", "[", RowBox[{"aMatrix", ",", "x"}], 
                    "]"}]}], ";"}], "\[IndentingNewLine]", 
              RowBox[{RowBox[{"recordCheck", "[", RowBox[
                   {"\"Monic characteristic polynomial\"", ",", "chi", ",", 
                    RowBox[{"Expand", "[", RowBox[{SuperscriptBox["x", "3"], 
                        "-", RowBox[{"p2", " ", "x"}], "-", "q3"}], "]"}]}], 
                  "]"}], ";"}], "\[IndentingNewLine]", RowBox[{
                RowBox[{"recordCheck", "[", RowBox[
                   {"\"Native odd-order polynomial convention\"", ",", 
                    RowBox[{"Expand", "[", RowBox[{"-", RowBox[
                         {"CharacteristicPolynomial", "[", RowBox[{"aMatrix", 
                          ",", "x"}], "]"}]}], "]"}], ",", "chi"}], "]"}], 
                ";"}], "\[IndentingNewLine]", RowBox[{"{", RowBox[
                 {"chi", ",", "nilConditions"}], "}"}]}], "Input", 
            InitializationCell -> False, CellLabel -> "In[3]:=", 
            ExpressionUUID -> "55ef32cd-703c-de46-841d-39df678a285a"], 
           Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{RowBox[{"2", " ", 
                     SuperscriptBox["a", "3"]}], "+", RowBox[{"2", " ", "a", 
                     " ", "b", " ", "c"}], "-", RowBox[{SuperscriptBox["c", 
                      "2"], " ", "d"}], "-", RowBox[{SuperscriptBox["b", 
                      "2"], " ", "f"}], "-", RowBox[{"2", " ", "a", " ", "d", 
                     " ", "f"}], "-", RowBox[{"3", " ", SuperscriptBox["a", 
                      "2"], " ", "x"}], "-", RowBox[{"2", " ", "b", " ", "c", 
                     " ", "x"}], "-", RowBox[{"d", " ", "f", " ", "x"}], "+", 
                   SuperscriptBox["x", "3"]}], ",", RowBox[
                  {RowBox[{RowBox[{RowBox[{"3", " ", SuperscriptBox["a", 
                          "2"]}], "+", RowBox[{"2", " ", "b", " ", "c"}], 
                       "+", RowBox[{"d", " ", "f"}]}], "\[Equal]", "0"}], 
                   "&&", RowBox[{RowBox[{RowBox[{RowBox[{"-", "2"}], " ", 
                         SuperscriptBox["a", "3"]}], "-", RowBox[{"2", " ", 
                         "a", " ", "b", " ", "c"}], "+", RowBox[
                        {SuperscriptBox["c", "2"], " ", "d"}], "+", RowBox[
                        {SuperscriptBox["b", "2"], " ", "f"}], "+", RowBox[
                        {"2", " ", "a", " ", "d", " ", "f"}]}], "\[Equal]", 
                     "0"}]}]}], "}"}]], "Output", CellLabel -> "Out[3]=", 
            ExpressionUUID -> "96ee9720-57b7-0547-b808-2233621431b3"]}, 
          Open]], Cell["We use the monic convention det(x I-A)=x^3-Px-Q. \
Mathematica's CharacteristicPolynomial uses det(A-x I), with the opposite \
sign in order three. The helper avoids this convention ambiguity. \
Cayley-Hamilton replaces x^3 by A^3, -Px by -PA, and the constant -Q by -QI, \
giving the same cube identity.", "Text", ExpressionUUID -> 
          "d4cf6a86-f745-4046-9ed2-1ce9b6629512"], 
        Cell[CellGroupData[{Cell[BoxData[{RowBox[{RowBox[{"traceOnly", "=", 
                  RowBox[{"mat", "[", RowBox[{"{", RowBox[{"1", ",", "1", 
                        ",", "1", ",", "1", ",", "1"}], "}"}], "]"}]}], 
                ";"}], "\[IndentingNewLine]", RowBox[{RowBox[{"recordCheck", 
                  "[", RowBox[{"\"Trace-only example has trace zero\"", ",", 
                    RowBox[{"Tr", "[", "traceOnly", "]"}], ",", "0"}], "]"}], 
                ";"}], "\[IndentingNewLine]", RowBox[{RowBox[{"recordCheck", 
                  "[", RowBox[{"\"Trace-only example is not nilpotent\"", 
                    ",", RowBox[{"zeroMatrixQ", "[", RowBox[{"MatrixPower", 
                        "[", RowBox[{"traceOnly", ",", "3"}], "]"}], "]"}], 
                    ",", "False"}], "]"}], ";"}], "\[IndentingNewLine]", 
              RowBox[{"{", RowBox[{TagBox["traceOnly", Function[BoxForm`e$, 
                    MatrixForm[BoxForm`e$]]], ",", RowBox[{"monicChar", "[", 
                    RowBox[{"traceOnly", ",", "x"}], "]"}]}], "}"}]}], 
            "Input", InitializationCell -> False, CellLabel -> "In[4]:=", 
            ExpressionUUID -> "d243b370-aab5-8a45-a95d-d7fcd65288d0"], 
           Cell[BoxData[RowBox[{"{", RowBox[{TagBox[RowBox[{"(", 
                    "\[NoBreak]", GridBox[{{"1", "1", "1"}, {"1", RowBox[
                        {"-", "2"}], "1"}, {"1", "1", "1"}}, 
                     GridBoxAlignment -> {"Columns" -> {{Center}}, "Rows" -> 
                        {{Baseline}}}, GridBoxSpacings -> {"Columns" -> 
                        {Offset[0.27999999999999997], {Offset[0.7]}, Offset[
                          0.27999999999999997]}, "Rows" -> {Offset[0.2], 
                         {Offset[0.4]}, Offset[0.2]}}], "\[NoBreak]", ")"}], 
                  Function[BoxForm`e$, MatrixForm[BoxForm`e$]]], ",", 
                 RowBox[{RowBox[{RowBox[{"-", "6"}], " ", "x"}], "+", 
                   SuperscriptBox["x", "3"]}]}], "}"}]], "Output", 
            CellLabel -> "Out[4]=", ExpressionUUID -> 
             "6d8d79b7-ef08-3243-8dca-197a771539c5"]}, Open]]}, Open]], 
     Cell[CellGroupData[{Cell["3. Solve for c and f when a,b,d are given", 
         "Section", ExpressionUUID -> 
          "a98297b2-c7d3-9546-8e4a-4edffcbb6bda"], Cell["Because d is \
nonzero, solve P=0 first for f. Substitute this into Q=0 and multiply by d. \
The result is a quadratic equation in c, rather than the single nonzero \
solution present when a=0.", "Text", ExpressionUUID -> 
          "9b2ae138-71d9-0740-b296-df5427a12f54"], 
        Cell[BoxData[FormBox[TagBox[RowBox[{"f", "\[LongEqual]", 
              RowBox[{"-", FractionBox[RowBox[{RowBox[{"3", " ", 
                     SuperscriptBox["a", "2"]}], "+", RowBox[{"2", " ", "b", 
                     " ", "c"}]}], "d"]}]}], HoldForm], TraditionalForm]], 
         "DisplayFormula", ExpressionUUID -> 
          "692038ae-e100-6c41-9060-5f42e1579d14"], 
        Cell[BoxData[FormBox[TagBox[RowBox[{RowBox[{RowBox[{SuperscriptBox[
                   "d", "2"], " ", SuperscriptBox["c", "2"]}], "-", 
                RowBox[{RowBox[{"(", RowBox[{RowBox[{"6", " ", "a", " ", "b", 
                        " ", "d"}], "+", RowBox[{"2", " ", SuperscriptBox[
                         "b", "3"]}]}], ")"}], " ", "c"}], "-", 
                RowBox[{"8", " ", SuperscriptBox["a", "3"], " ", "d"}], "-", 
                RowBox[{"3", " ", SuperscriptBox["a", "2"], " ", 
                  SuperscriptBox["b", "2"]}]}], "\[LongEqual]", "0"}], 
            HoldForm], TraditionalForm]], "DisplayFormula", 
         ExpressionUUID -> "7fc8f36b-f4ca-f043-a9b8-4ef948221e2d"], 
        Cell[CellGroupData[{Cell[BoxData[{RowBox[{RowBox[{"fRule", "=", 
                  RowBox[{"f", "\[Rule]", RowBox[{"-", FractionBox[RowBox[
                        {RowBox[{"3", " ", SuperscriptBox["a", "2"]}], "+", 
                         RowBox[{"2", " ", "b", " ", "c"}]}], "d"]}]}]}], 
                ";"}], "\[IndentingNewLine]", RowBox[{RowBox[{"quadratic", 
                  "=", RowBox[{"Expand", "[", RowBox[{"d", " ", RowBox[
                       {"(", RowBox[{"q3", "/.", "\[VeryThinSpace]", 
                          "fRule"}], ")"}]}], "]"}]}], ";"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{"expectedQuadratic", 
                  "=", RowBox[{RowBox[{SuperscriptBox["d", "2"], " ", 
                      SuperscriptBox["c", "2"]}], "-", RowBox[
                     {RowBox[{"(", RowBox[{RowBox[{"6", " ", "a", " ", "b", 
                          " ", "d"}], "+", RowBox[{"2", " ", SuperscriptBox[
                          "b", "3"]}]}], ")"}], " ", "c"}], "-", RowBox[
                     {"8", " ", SuperscriptBox["a", "3"], " ", "d"}], "-", 
                    RowBox[{"3", " ", SuperscriptBox["a", "2"], " ", 
                      SuperscriptBox["b", "2"]}]}]}], ";"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{"recordCheck", "[", 
                  RowBox[{"\"Eliminated quadratic\"", ",", "quadratic", ",", 
                    RowBox[{"Expand", "[", "expectedQuadratic", "]"}]}], 
                  "]"}], ";"}], "\[IndentingNewLine]", RowBox[{
                RowBox[{"r2", "=", RowBox[{SuperscriptBox["b", "2"], "+", 
                    RowBox[{"2", " ", "a", " ", "d"}]}]}], ";"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{"h3", "=", RowBox[
                   {RowBox[{"c", " ", SuperscriptBox["d", "2"]}], "-", 
                    SuperscriptBox["b", "3"], "-", RowBox[{"3", " ", "a", 
                      " ", "b", " ", "d"}]}]}], ";"}], "\[IndentingNewLine]", 
              RowBox[{RowBox[{"recordCheck", "[", RowBox[
                   {"\"Quadratic discriminant\"", ",", RowBox[{"Factor", "[", 
                      RowBox[{"Discriminant", "[", RowBox[{"quadratic", ",", 
                          "c"}], "]"}], "]"}], ",", RowBox[{"4", " ", 
                      SuperscriptBox["r2", "3"]}]}], "]"}], ";"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{"recordCheck", "[", 
                  RowBox[{"\"Key elimination identity\"", ",", RowBox[
                     {"Expand", "[", RowBox[{SuperscriptBox["h3", "2"], "-", 
                        SuperscriptBox["r2", "3"], "-", RowBox[
                         {SuperscriptBox["d", "3"], " ", "q3"}], "+", 
                        RowBox[{SuperscriptBox["d", "2"], " ", "r2", " ", 
                          "p2"}]}], "]"}], ",", "0"}], "]"}], ";"}], 
              "\[IndentingNewLine]", RowBox[{RowBox[{"cCandidates", "=", 
                  RowBox[{"{", RowBox[{FractionBox[RowBox[{SuperscriptBox[
                          "b", "3"], "+", RowBox[{"3", " ", "a", " ", "b", 
                          " ", "d"}], "+", SuperscriptBox["r2", RowBox[
                          {"3", "/", "2"}]]}], SuperscriptBox["d", "2"]], 
                      ",", FractionBox[RowBox[{SuperscriptBox["b", "3"], "+", 
                         RowBox[{"3", " ", "a", " ", "b", " ", "d"}], "-", 
                         SuperscriptBox["r2", RowBox[{"3", "/", "2"}]]}], 
                       SuperscriptBox["d", "2"]]}], "}"}]}], ";"}], 
              "\[IndentingNewLine]", TagBox[GridBox[{{"\"Quadratic in c\"", 
                  RowBox[{"quadratic", "\[Equal]", "0"}]}, 
                 {"\"Discriminant\"", RowBox[{"4", " ", SuperscriptBox["r2", 
                     "3"]}]}, {"\"Candidate c values\"", "cCandidates"}, 
                 {"\"Recover f\"", "fRule"}}, AutoDelete -> False, 
                GridBoxAlignment -> {"Columns" -> {{Left}}}, 
                GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> 
                   {{Automatic}}}], "Grid"]}], "Input", InitializationCell -> 
             False, CellLabel -> "In[5]:=", ExpressionUUID -> 
             "d2e24ea9-8606-6149-a520-520a75a496da"], 
           Cell[BoxData[TagBox[GridBox[{{"\"Quadratic in c\"", RowBox[
                  {RowBox[{RowBox[{RowBox[{"-", "3"}], " ", SuperscriptBox[
                        "a", "2"], " ", SuperscriptBox["b", "2"]}], "-", 
                     RowBox[{"2", " ", SuperscriptBox["b", "3"], " ", "c"}], 
                     "-", RowBox[{"8", " ", SuperscriptBox["a", "3"], " ", 
                       "d"}], "-", RowBox[{"6", " ", "a", " ", "b", " ", "c", 
                       " ", "d"}], "+", RowBox[{SuperscriptBox["c", "2"], 
                       " ", SuperscriptBox["d", "2"]}]}], "\[Equal]", "0"}]}, 
                {"\"Discriminant\"", RowBox[{"4", " ", SuperscriptBox[
                    RowBox[{"(", RowBox[{SuperscriptBox["b", "2"], "+", 
                        RowBox[{"2", " ", "a", " ", "d"}]}], ")"}], "3"]}]}, 
                {"\"Candidate c values\"", RowBox[{"{", RowBox[{FractionBox[
                      RowBox[{SuperscriptBox["b", "3"], "+", RowBox[{"3", 
                          " ", "a", " ", "b", " ", "d"}], "+", SuperscriptBox[
                         RowBox[{"(", RowBox[{SuperscriptBox["b", "2"], "+", 
                          RowBox[{"2", " ", "a", " ", "d"}]}], ")"}], 
                         RowBox[{"3", "/", "2"}]]}], SuperscriptBox["d", 
                       "2"]], ",", FractionBox[RowBox[{SuperscriptBox["b", 
                         "3"], "+", RowBox[{"3", " ", "a", " ", "b", " ", 
                          "d"}], "-", SuperscriptBox[RowBox[{"(", RowBox[
                          {SuperscriptBox["b", "2"], "+", RowBox[{"2", " ", 
                          "a", " ", "d"}]}], ")"}], RowBox[{"3", "/", 
                          "2"}]]}], SuperscriptBox["d", "2"]]}], "}"}]}, 
                {"\"Recover f\"", RowBox[{"f", "\[Rule]", FractionBox[
                    RowBox[{RowBox[{RowBox[{"-", "3"}], " ", SuperscriptBox[
                         "a", "2"]}], "-", RowBox[{"2", " ", "b", " ", 
                        "c"}]}], "d"]}]}}, AutoDelete -> False, 
               GridBoxAlignment -> {"Columns" -> {{Left}}}, 
               GridBoxItemSize -> {"Columns" -> {{Automatic}}, "Rows" -> 
                  {{Automatic}}}], "Grid"]], "Output", CellLabel -> 
             "Out[5]=", ExpressionUUID -> 
             "11dabff1-4391-914f-8961-81895c55cf04"]}, Open]], 
        Cell["Let R=b^2+2ad. The discriminant is 4R^3. Therefore R<0 gives no \
real nilpotent solution for those a,b,d; R=0 gives one repeated candidate; \
R>0 gives two real candidates. For each candidate compute f and discard it if \
c or f is zero, because those values are forbidden in our family. Two \
quadratic candidates need not mean two allowed dense matrices.", "Text", 
         ExpressionUUID -> "ddaf8c24-441a-3848-8c3c-04692cdf2245"], 
        Cell[BoxData[FormBox[TagBox[RowBox[{"R", "\[LongEqual]", 
              RowBox[{SuperscriptBox["b", "2"], "+", RowBox[{"2", " ", "a", 
                  " ", "d"}]}]}], HoldForm], TraditionalForm]], 
         "DisplayFormula", ExpressionUUID -> 
          "fd4bd698-c63e-2a4e-be18-92d7df719372"], 
        Cell[BoxData[FormBox[TagBox[RowBox[{"H", "\[LongEqual]", 
              RowBox[{RowBox[{"c", " ", SuperscriptBox["d", "2"]}], "-", 
                SuperscriptBox["b", "3"], "-", RowBox[{"3", " ", "a", " ", 
                  "b", " ", "d"}]}]}], HoldForm], TraditionalForm]], 
         "DisplayFormula", ExpressionUUID -> 
          "c2722430-e78b-f147-88fd-d8c4aba71bed"], 
        Cell[BoxData[FormBox[TagBox[RowBox[{RowBox[{SuperscriptBox["H", "2"], 
                "-", SuperscriptBox["R", "3"]}], "\[LongEqual]", 
              RowBox[{RowBox[{SuperscriptBox["d", "3"], " ", "Q"}], "-", 
                RowBox[{SuperscriptBox["d", "2"], " ", "R", " ", "P"}]}]}], 
            HoldForm], TraditionalForm]], "DisplayFormula", 
         ExpressionUUID -> "52ecf093-534c-7f40-ba3e-d7036c386256"], 
        Cell["At nilpotency P=Q=0, so H^2=R^3. Since H is real, this also \
proves R>=0 without invoking the quadratic formula. These two auxiliary \
quantities will make a complete parameterization especially simple.", "Text", 
         ExpressionUUID -> "5e808563-5bef-ac4e-81ff-b82754139bba"], 
        Cell[CellGroupData[{Cell[BoxData[{RowBox[{RowBox[{"recordCheck", "[", 
                  RowBox[
                   {"\"H squared equals R cubed forces R nonnegative\"", ",", 
                    RowBox[{"Resolve", "[", RowBox[{RowBox[{SubscriptBox[
                          "\[ForAll]", RowBox[{"{", RowBox[{"rr", ",", 
                          "hh"}], "}"}]], RowBox[{"(", RowBox[{RowBox[
                          {SuperscriptBox["hh", "2"], "\[Equal]", 
                          SuperscriptBox["rr", "3"]}], "\[Implies]", RowBox[
                          {"rr", "\[GreaterEqual]", "0"}]}], ")"}]}], ",", 
                        TemplateBox[{}, "Reals"]}], "]"}], ",", "True"}], 
                  "]"}], ";"}], "\[IndentingNewLine]", RowBox[{
                RowBox[{"recordCheck", "[", RowBox[
                   {"\"R zero forces H zero\"", ",", RowBox[{"Resolve", "[", 
                      RowBox[{RowBox[{SubscriptBox["\[ForAll]", RowBox[
                          {"{", "hh", "}"}]], RowBox[{"(", RowBox[{RowBox[
                          {SuperscriptBox["hh", "2"], "\[Equal]", "0"}], 
                          "\[Implies]", RowBox[{"hh", "\[Equal]", "0"}]}], 
                          ")"}]}], ",", TemplateBox[{}, "Reals"]}], "]"}], 
                    ",", "True"}], "]"}], ";"}], "\[IndentingNewLine]", 
              RowBox[{RowBox[{"recordCheck", "[", RowBox[
                   {"\"Recover the signed square root for R positive\"", ",", 
                    RowBox[{"Resolve", "[", RowBox[{RowBox[{SubscriptBox[
                          "\[ForAll]", RowBox[{"{", RowBox[{"rr", ",", 
                          "hh"}], "}"}]], RowBox[{"(", RowBox[{RowBox[
                          {RowBox[{"rr", ">", "0"}], "&&", RowBox[
                          {SuperscriptBox["hh", "2"], "\[Equal]", 
                          SuperscriptBox["rr", "3"]}]}], "\[Implies]", 
                          RowBox[{RowBox[{SuperscriptBox[RowBox[{"(", 
                          FractionBox["hh", "rr"], ")"}], "2"], "\[Equal]", 
                          "rr"}], "&&", RowBox[{SuperscriptBox[RowBox[{"(", 
                          FractionBox["hh", "rr"], ")"}], "3"], "\[Equal]", 
                          "hh"}]}]}], ")"}]}], ",", TemplateBox[{}, 
                         "Reals"]}], "]"}], ",", "True"}], "]"}], ";"}], 
              "\[IndentingNewLine]", RowBox[{"{", RowBox[{RowBox[{"R", "<", 
                    "0"}], ",", RowBox[{"R", "\[Equal]", "0"}], ",", 
                  RowBox[{"R", ">", "0"}]}], "}"}]}], "Input", 
            InitializationCell -> False, CellLabel -> "In[6]:=", 
            ExpressionUUID -> "34e36f66-73af-9644-bab2-a7d51d8bf771"], 
           Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"R", "<", "0"}], ",", 
                 RowBox[{"R", "\[Equal]", "0"}], ",", RowBox[{"R", ">", 
                   "0"}]}], "}"}]], "Output", CellLabel -> "Out[6]=", 
            ExpressionUUID -> "18ac94b2-cfce-4b4f-92d7-28b6e44bbf0e"]}, 
          Open]]}, Open]], Cell[CellGroupData[
       {Cell["4. A complete three-parameter formula without radicals", 
         "Section", ExpressionUUID -> 
          "6d7c9a36-4639-4d4d-8a4a-4f8dd1b0a7f8"], Cell["Choose nonzero real \
b and d, and choose a real parameter u. Define the other three values as \
follows. There are now three freely chosen parameters, compared with two in \
the zero-diagonal notebook.", "Text", ExpressionUUID -> 
          "a0d40a96-f052-6440-aeb1-d39ecbf4006b"], 
        Cell[BoxData[FormBox[TagBox[RowBox[{"a", "\[LongEqual]", 
              FractionBox[RowBox[{SuperscriptBox["b", "2"], " ", 
                 RowBox[{"(", RowBox[{SuperscriptBox["u", "2"], "-", "1"}], 
                   ")"}]}], RowBox[{"2", " ", "d"}]]}], HoldForm], 
           TraditionalForm]], "DisplayFormula", ExpressionUUID -> 
          "abe443fc-7bd8-b343-9e99-e6b9df54228a"], 
        Cell[BoxData[FormBox[TagBox[RowBox[{"c", "\[LongEqual]", 
              FractionBox[RowBox[{SuperscriptBox["b", "3"], " ", 
                 SuperscriptBox[RowBox[{"(", RowBox[{"u", "+", "1"}], ")"}], 
                  "2"], " ", RowBox[{"(", RowBox[{RowBox[{"2", " ", "u"}], 
                     "-", "1"}], ")"}]}], RowBox[{"2", " ", SuperscriptBox[
                  "d", "2"]}]]}], HoldForm], TraditionalForm]], 
         "DisplayFormula", ExpressionUUID -> 
          "9e52f888-65eb-aa4a-b21b-073edd2710e7"], 
        Cell[BoxData[FormBox[TagBox[RowBox[{"f", "\[LongEqual]", 
              RowBox[{"-", FractionBox[RowBox[{SuperscriptBox["b", "4"], " ", 
                   SuperscriptBox[RowBox[{"(", RowBox[{"u", "+", "1"}], 
                      ")"}], "3"], " ", RowBox[{"(", RowBox[{RowBox[{"3", 
                         " ", "u"}], "-", "1"}], ")"}]}], RowBox[{"4", " ", 
                   SuperscriptBox["d", "3"]}]]}]}], HoldForm], 
           TraditionalForm]], "DisplayFormula", ExpressionUUID -> 
          "d796f1aa-b62f-6648-bef8-0076b1075157"], Cell["Require u != -1, u \
!= 1/3 and u != 1/2. These exclusions are exactly what keeps c and f nonzero. \
If a must also be nonzero, additionally require u != 1. The parameter u=1 \
recovers the earlier zero-diagonal solution; u=0 is allowed and produces \
square-zero matrices.", "Text", ExpressionUUID -> 
          "320df3d6-403a-9c4b-a061-488e17318a6b"], 
        Cell[CellGroupData[{Cell[BoxData[{RowBox[{RowBox[{"paramRules", "=", 
                  RowBox[{"{", RowBox[{RowBox[{"a", "\[Rule]", FractionBox[
